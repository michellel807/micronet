<% content_for :title, "Submission Successful" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "generate", "data-turbo-track": "reload" %>
<% end %>

<div class="generatescreen">
  <%= render "layouts/header" %>
  <main class="generate-main">
    <h1>Submission successful!</h1>
    <p>Your job is running, and you will receive an email containing a link to your
      results when it is finished. Thank you for using MicroNet!</p>
  </main>
  <%= render "layouts/footer" %>
</div>
