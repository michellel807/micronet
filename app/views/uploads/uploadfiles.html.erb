<div class="flex-wrapper">
  <%= render "partials/navbar"%>
  <div class='steps-container'>
    <div class='steps active'>
      <span>Upload Data</span>
    </div>
    <div class='steps'>
      <span>Environment(s)</span>
    </div>
    <div class='steps'>
      <span>Subsampling</span>
    </div>
    <div class='steps'>
      <span>Review</span>
    </div>
    <div class='steps'>
      <span>Finished</span>
    </div>
  </div>

  <p class="alert-warning"><%=flash[:alert]%></p>
  <p class="alert-success"><%=flash[:notice]%></p>
  <div class="general-white-block">
      <p>Please scroll down to review your files before moving to the next step.</p>
      <div class="row">
        <div class="column">
          <h2><%= link_to "Optical Density Data", @job.odfile_url %></h2>
          <div id="graph-frame">
            <iframe src= "<%= @odplot %>"></iframe>
          </div>
        </div>
        <div class="column">
          <h2><%= link_to "Meta Data", @job.metafile_url %></h2>
          <div class="scroll-container">
            <table class="metatable">
              <tbody>
                <% @metatable.each do |metarow| %>
                  <tr>
                    <% metarow.each do |metacol| %>
                        <td><%= metacol %></td>
                    <% end %>
                  </tr>
                <%end%>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <div class='bottomrow'>
        <div>
          <%= form_with url: "/uploads", method: :get do |form|%>
            <%= form.submit "Resubmit Files", class: 'savebutton' %>
          <% end %>
        </div>
        <div>
          <%= link_to "Next Step", "/environments", class: 'savebutton' %>
        </div>
      </div>
  </div>
  <%=render "partials/footer"%>
</div>