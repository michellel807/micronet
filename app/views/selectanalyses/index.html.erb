<!DOCTYPE html>
<html>
  <head>
    <title>Parameter page</title>
    <%= stylesheet_link_tag 'selectanalyses' %>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  </head>

<body>
  <div class="selectanalyses">
    <%= render "layouts/header" %>

    <main class="selectanalyses-shell">
      <%= render "layouts/stepper", current_step: 2 %>

      <% content_for :title, "Parameters page" %>
      <div class="selectanalyses-heading">
        <h1>Select Analyses</h1>
        <p>Please select the analyses you would like to generate. For more details on each analysis, please see the "Resources" tab.</p>
      </div>

      <%= form_with url: (session[:returning_from_review] ? '/review' : '/review'), method: :post do |form| %>
        <% if @mapping_file_paths.present? %>
          <%= hidden_field_tag 'file_data', @file_data_json %>
        <% end %>

        <% if flash[:error] %>
          <div class="analysis-alert"><%= flash[:error] %></div>
        <% end %>

        <div class="analyses-grid">
          <section class="analysis-section">
            <label class="analysis-card">
              <%= check_box_tag 'chart_types[]', 'raw_data', @selected_chart_types.include?('raw_data'), class: 'analysis-toggle' %>
              <span class="analysis-icon icon-bars"></span>
              <span class="analysis-copy">
                <span class="analysis-title">Raw Data Plot</span>
                <span class="analysis-description">Generate a growth curve for each well in the experimental design.</span>
                <span class="analysis-meta">96-well plate formats only</span>
              </span>
              <span class="analysis-check"></span>
            </label>
          </section>

          <section class="analysis-section">
            <label class="analysis-card">
              <%= check_box_tag 'chart_types[]', 'gp_plot', @selected_chart_types.include?('gp_plot'), class: 'analysis-toggle' %>
              <span class="analysis-icon icon-curve"></span>
              <span class="analysis-copy">
                <span class="analysis-title">Gaussian Process Plot</span>
                <span class="analysis-description">Plot a specified experimental property with one chosen condition.</span>
                <span class="analysis-meta">Includes optional subsetting</span>
              </span>
              <span class="analysis-check"></span>
            </label>

            <div class="gp-pool-by-container analysis-settings" style="<%= @selected_chart_types.include?('gp_plot') ? '' : 'display: none;' %>">
              <% if @mapping_file_paths.present? %>
                <label class="field-label" for="gp-pool-by-select">Pool by column</label>
                <%= select_tag 'gp_pool_by_column', options_for_select(@columns, @gp_pool_by_column), prompt: 'Select a column', id: 'gp-pool-by-select', class: 'analysis-dropdown' %>
              <% end %>
            </div>

            <div class="gp-subset-toggle analysis-settings" style="<%= @selected_chart_types.include?('gp_plot') ? '' : 'display: none;' %>">
              <p class="field-label">Subset the data?</p>
              <div class="segmented-options">
                <label>
                  <%= radio_button_tag 'gp_subset_choice', 'yes', @gp_subset_choice == 'yes', id: 'gp_subset_yes' %>
                  <span>Yes</span>
                </label>
                <label>
                  <%= radio_button_tag 'gp_subset_choice', 'no', @gp_subset_choice == 'no' || @gp_subset_choice.blank?, id: 'gp_subset_no' %>
                  <span>No</span>
                </label>
              </div>
            </div>

            <div class="gp-subset-container analysis-settings compact-setting" style="<%= @gp_subset_choice == 'yes' ? '' : 'display: none;' %>">
              <% if @mapping_file_paths.present? %>
                <label class="field-label" for="gp-subset-select">Subset column</label>
                <%= select_tag 'gp_subset_column', options_for_select(@columns, @gp_subset_column), prompt: 'Select a column', id: 'gp-subset-select', class: 'analysis-dropdown' %>
              <% end %>
            </div>

            <div id="gp-condition-checkboxes" class="checkbox-container chip-options" style="display: none;"></div>
          </section>

          <section class="analysis-section">
            <label class="analysis-card">
              <%= check_box_tag 'chart_types[]', 'fit_stats', @selected_chart_types.include?('fit_stats'), class: 'analysis-toggle' %>
              <span class="analysis-icon icon-stats"></span>
              <span class="analysis-copy">
                <span class="analysis-title">Fit Statistics</span>
                <span class="analysis-description">Summarize AUC, growth rate, carrying capacity, lag time, and doubling time.</span>
                <span class="analysis-meta">Optional replicate pooling</span>
              </span>
              <span class="analysis-check"></span>
            </label>

            <div class="radio-container analysis-settings" style="<%= @selected_chart_types.include?('fit_stats') ? '' : 'display: none;' %>">
              <p class="field-label">Pool replicates?</p>
              <div class="segmented-options">
                <label>
                  <input type="radio" name="pool_replicates" value="yes" <%= @pool_replicates == 'yes' ? 'checked' : '' %>>
                  <span>Yes</span>
                </label>
                <label>
                  <input type="radio" name="pool_replicates" value="no" <%= @pool_replicates == 'no' || @pool_replicates.blank? ? 'checked' : '' %>>
                  <span>No</span>
                </label>
              </div>
            </div>

            <div class="checkbox-container chip-options">
              <div id="checkbox-content">
                <h3 id="checkbox-header">Pool variables</h3>
                <div class="additional-text">
                  Select the variable(s) to pool on. Multiple variables are pooled by unique combinations. <a href="http://firasmidani.github.io/amiga/doc/pooling.html">Learn more</a>.
                </div>
                <% @pool_options.each do |option| %>
                  <% next if option.downcase.include?('well') %>
                  <label>
                    <input type="checkbox" name="pool_options[]" value="<%= option %>" <%= @pool_options_selected.include?(option) ? 'checked' : '' %>>
                    <span><%= option %></span>
                  </label>
                <% end %>
              </div>
            </div>
          </section>

          <section class="analysis-section">
            <label class="analysis-card">
              <%= check_box_tag 'chart_types[]', 'heatmap_plot', @selected_chart_types.include?('heatmap_plot'), class: 'analysis-toggle' %>
              <span class="analysis-icon icon-grid"></span>
              <span class="analysis-copy">
                <span class="analysis-title">Heatmap Plot</span>
                <span class="analysis-description">Visualize fit statistics across selected conditions and axes.</span>
                <span class="analysis-meta">Choose metric, x-axis, and y-axis</span>
              </span>
              <span class="analysis-check"></span>
            </label>

            <div class="heatmap-container analysis-settings" style="<%= @selected_chart_types.include?('heatmap_plot') ? '' : 'display: none;' %>">
              <% if @mapping_file_paths.present? %>
                <label class="field-label" for="heatmap_value">Heatmap value</label>
                <%= select_tag 'heatmap_value', options_for_select([
                  'AUC in units of OD',
                  'Growth Rate',
                  'Linear Carrying Capacity in units of OD',
                  'Lag Time',
                  'Doubling Time'
                ], @heatmap_value), prompt: 'Select a value', id: 'heatmap_value', class: 'analysis-dropdown' %>

                <div class="axis-grid">
                  <div>
                    <label class="field-label" for="heatmap_x">x-axis</label>
                    <%= select_tag 'heatmap_x', options_for_select(@columns, @heatmap_x), prompt: 'Select x-axis', id: 'heatmap_x', class: 'analysis-dropdown' %>
                  </div>
                  <div>
                    <label class="field-label" for="heatmap_y">y-axis</label>
                    <%= select_tag 'heatmap_y', options_for_select(@columns, @heatmap_y), prompt: 'Select y-axis', id: 'heatmap_y', class: 'analysis-dropdown' %>
                  </div>
                </div>
              <% end %>
            </div>
          </section>

          <section class="analysis-section">
            <label class="analysis-card">
              <%= check_box_tag 'chart_types[]', 'test-hypothesis', @selected_chart_types.include?('test-hypothesis'), class: 'analysis-toggle' %>
              <span class="analysis-icon icon-hypothesis"></span>
              <span class="analysis-copy">
                <span class="analysis-title">Test Hypothesis</span>
                <span class="analysis-description">Compare differential growth with log Bayes Factor scores and OD differences.</span>
                <span class="analysis-meta">Choose variable and two conditions</span>
              </span>
              <span class="analysis-check"></span>
            </label>

            <div class="test-hypothesis-container analysis-settings" style="<%= @selected_chart_types.include?('test-hypothesis') ? '' : 'display: none;' %>">
              <% if @mapping_file_paths.present? %>
                <label class="field-label" for="column-test">Variable to test</label>
                <%= select_tag 'column_test', options_for_select(@columns, @column_test), prompt: 'Select a column', id: 'column-test', class: 'analysis-dropdown' %>
              <% end %>
            </div>

            <div class="test-hypothesis-options-container analysis-settings" style="display: none;">
              <p class="field-label">Choose two conditions</p>
              <div class="axis-grid">
                <%= select_tag 'condition1_test', '', prompt: 'Select a condition', id: 'condition1-test', class: 'analysis-dropdown' %>
                <%= select_tag 'condition2_test', '', prompt: 'Select another condition', id: 'condition2-test', class: 'analysis-dropdown' %>
              </div>
              <div id="subset-dropdowns-test" class="generated-subsets"></div>
            </div>
          </section>

          <section class="analysis-section">
            <label class="analysis-card">
              <%= check_box_tag 'chart_types[]', 'compare-parameters', @selected_chart_types.include?('compare-parameters'), class: 'analysis-toggle' %>
              <span class="analysis-icon icon-compare"></span>
              <span class="analysis-copy">
                <span class="analysis-title">Compare Parameters</span>
                <span class="analysis-description">Compare growth parameters between two conditions of a variable.</span>
                <span class="analysis-meta">Optional subset controls</span>
              </span>
              <span class="analysis-check"></span>
            </label>

            <div class="compare-parameters-container analysis-settings" style="<%= @selected_chart_types.include?('compare-parameters') ? '' : 'display: none;' %>">
              <% if @mapping_file_paths.present? %>
                <label class="field-label" for="column-pooled">Variable to compare</label>
                <%= select_tag 'column_pooled', options_for_select(@columns, @column_pooled), prompt: 'Select a column', id: 'column-pooled', class: 'analysis-dropdown' %>
              <% end %>
            </div>

            <div class="compare-options-pooled-container analysis-settings" style="display: none;">
              <p class="field-label">Choose two conditions</p>
              <div class="axis-grid">
                <%= select_tag 'condition1_pooled', '', prompt: 'Select a condition', id: 'condition1-pooled', class: 'analysis-dropdown' %>
                <%= select_tag 'condition2_pooled', '', prompt: 'Select another condition', id: 'condition2-pooled', class: 'analysis-dropdown' %>
              </div>
              <div id="subset-dropdowns-pooled" class="generated-subsets"></div>
            </div>
          </section>
        </div>

        <div class="analysis-actions">
          <% if session[:returning_from_review] %>
            <%= submit_tag 'Back to Review', class: 'analysis-button secondary-action', id: 'review-button' %>
            <%= link_to 'Start Over', upload_path, class: 'edit-button' %>
          <% else %>
            <%= submit_tag 'Review', class: 'analysis-button', id: 'review-button' %>
          <% end %>
        </div>
      <% end %>
    </main>

 <%= render "layouts/footer" %>


  <script>
  $(document).ready(function() {
    $('#review-button').on('click', function(e) {
        var poolReplicates = $("input[name='pool_replicates']:checked").val();
        var selectedOptions = $("input[name='pool_options[]']:checked").length;
        
        if (poolReplicates === 'yes' && selectedOptions === 0) {
          e.preventDefault();
          alert("Please select at least one parameter to pool on for the Fit Statistics analysis, or select 'No'.");
        }
      });

    $("input[name='chart_types[]'][value='gp_plot']").on("change", function () {
      if ($(this).is(":checked")) {
        $(".gp-pool-by-container").show();
        $(".gp-subset-toggle").show(); // show Yes/No subset toggle
        $(".gp-subset-container").hide(); // keep hidden until user clicks Yes
        $("#gp-condition-checkboxes").hide().empty(); // clear any old values
      } else {
        $(".gp-pool-by-container").hide();
        $(".gp-subset-toggle").hide();
        $(".gp-subset-container").hide();
        $("#gp-condition-checkboxes").hide().empty();
      }
    });

    // When user selects "Yes" or "No" for Subset
    $("input[name='gp_subset_choice']").on("change", function () {
      if ($(this).val() === "yes") {
        $(".gp-subset-container").show();
      } else {
        $(".gp-subset-container").hide();
        $("#gp-condition-checkboxes").hide().empty();
      }
    });

    $("#gp-subset-select").on("change", function () {
      const selectedColumn = $(this).val();
      const fileData = JSON.parse($("#file_data").val());
      const rows = fileData.trim().split("\n");
      const header = rows.shift().split("\t");

      const colIndex = header.indexOf(selectedColumn);
      if (colIndex === -1) return;

      const uniqueValues = new Set();
      rows.forEach(row => {
        const val = row.split("\t")[colIndex];
        if (val && val.trim()) uniqueValues.add(val.trim());
      });

      const $checkboxes = $("#gp-condition-checkboxes");
      $checkboxes.empty().show();

      $("<p>").text("Choose value(s) from the subset column:").appendTo($checkboxes);

      [...uniqueValues].sort().forEach(value => {
        const checkbox = $("<label style='margin-right: 10px; display: inline-block;'>")
          .append($("<input type='checkbox' name='gp_subset_values[]'>").val(value))
          .append(" " + value);
        $checkboxes.append(checkbox);
      });
    });

    $("input[name='chart_types[]'][value='test-hypothesis']").on("change", function() {
      if ($(this).is(":checked")) {
        $(".test-hypothesis-container").show();
      } else {
        $(".test-hypothesis-container").hide();
        $(".test-hypothesis-options-container").hide();
        $("#subset-dropdowns-test").empty();
      }
    });

    $("input[name='chart_types[]'][value='compare-parameters']").on("change", function() {
      if ($(this).is(":checked")) {
        $(".compare-parameters-container").show();
      } else {
        $(".compare-parameters-container").hide();
        $(".compare-options-pooled-container").hide();
        $("#subset-dropdowns-pooled").empty();
      }
    });

    $("input[name='chart_types[]'][value='fit_stats']").on("change", function() {
      if ($(this).is(":checked")) {
        $(".radio-container").show();
        $("input[name='pool_replicates'][value='no']").prop("checked", true);
        $('#heatmap-section').show();
      } else {
        $(".radio-container").hide();
        $('#heatmap-section').hide();
        $('#heatmap-options').hide();
      }
    });

    $("input[name='chart_types[]'][value='heatmap_plot']").on("change", function () {
      if ($(this).is(":checked")) {
        $(".heatmap-container").show();
      } else {
        $(".heatmap-container").hide();
      }
    });

    $("#gp-subset-select").on("change", function () {
      const selectedColumn = $(this).val();
      const fileData = JSON.parse($("#file_data").val());
      const rows = fileData.trim().split("\n");
      const header = rows.shift().split("\t");
      const colIndex = header.indexOf(selectedColumn);

      const uniqueValues = new Set();
      rows.forEach(row => {
        const val = row.split("\t")[colIndex];
        if (val && val.trim()) uniqueValues.add(val.trim());
      });

      const $checkboxContainer = $("#gp-condition-checkboxes");
      $checkboxContainer.empty().show();

      $checkboxContainer.append(`<p style="margin-bottom: 6px;">Choose the value(s) to include:</p>`);
      [...uniqueValues].sort().forEach(val => {
        const checkbox = $(`
          <label style="display: inline-block; margin-right: 10px;">
            <input type="checkbox" name="gp_conditions[]" value="${val}">
            ${val}
          </label>
        `);
        $checkboxContainer.append(checkbox);
      });
    });

      function generateSubsetDropdowns(column, containerId, prefix) {
      const fileData = JSON.parse($("#file_data").val());
      const rows = fileData.trim().split("\n");
      const header = rows.shift().split("\t");
      const columnIndex = header.indexOf(column);

      // Extract conditions for the main column
      const conditions = [...new Set(rows.map(row => row.split("\t")[columnIndex])
        .filter(val => val && !column.toLowerCase().includes("well")))];

      // Update condition dropdowns
      $(`#condition1-${prefix}`).empty().append($('<option>', { text: 'Select a condition' }));
      $(`#condition2-${prefix}`).empty().append($('<option>', { text: 'Select another condition' }));
      conditions.forEach(condition => {
        $(`#condition1-${prefix}`).append($('<option>', { text: condition, value: condition }));
        $(`#condition2-${prefix}`).append($('<option>', { text: condition, value: condition }));
      });

      // Show section
      if (prefix === "test") {
        $(".test-hypothesis-options-container").show();
      } else if (prefix === "pooled") {
        $(".compare-options-pooled-container").show();
      }

      // Generate subset dropdowns
      const remainingColumns = header.filter(col => col !== column && !col.toLowerCase().includes("well"));
      const subsetDropdowns = $(`#subset-dropdowns-${prefix}`);
      subsetDropdowns.empty();
      $("<p />").text("Subset data so conditions can be directly compared (This is optional: choose as many subsettings as you wish):")
        .appendTo(subsetDropdowns);

      remainingColumns.forEach(col => {
        const cleanCol = col.replace(/(\r\n|\n|\r)/gm, "");
        const select = $("<select />")
          .attr("name", `${prefix}_subset_${cleanCol}`) // name is now unique
          .attr("id", `${prefix}_subset_${cleanCol}`)   // optional unique id
          .addClass("analysis-dropdown");
        $("<option />").text(`Select a value for ${cleanCol}`).appendTo(select);

        rows.forEach(row => {
          const values = row.split("\t");
          const value = values[header.indexOf(col)];
          if (value && select.find(`option[value="${value}"]`).length === 0) {
            $("<option />").text(value).val(value).appendTo(select);
          }
        });

        select.appendTo(subsetDropdowns);
      });
    }

    $("#column-test").on("change", function () {
      const column = $(this).val();
      if (column) {
        generateSubsetDropdowns(column, "test", "test");
      } else {
        $(".test-options-container").hide();
        $("#subset-dropdowns-test").empty();
      }
    });

    $("#column-pooled").on("change", function () {
      const column = $(this).val();
      if (column) {
        generateSubsetDropdowns(column, "pooled", "pooled");
      } else {
        $(".pooled-options-container").hide();
        $("#subset-dropdowns-pooled").empty();
      }
    });

    // Helper function to exclude selected value from another select's options
    function setupExclusionFilter(triggerSelector, targetSelector) {
      $(triggerSelector).on('change', function () {
        const selectedVal = $(this).val();
        const $target = $(targetSelector);

        // Save original options once
        if (!$target.data('original-options')) {
          const originalOptions = [];
          $target.find('option').each(function () {
            originalOptions.push({
              value: this.value,
              text: this.text,
              disabled: this.disabled,
              selected: this.selected
            });
          });
          $target.data('original-options', originalOptions);
        }

        // Rebuild target select excluding selected value
        const originalOptions = $target.data('original-options');
        $target.empty();

        originalOptions.forEach(option => {
          if (option.value !== selectedVal) {
            const opt = $('<option>', {
              value: option.value,
              text: option.text
            });
            if (option.disabled) opt.prop('disabled', true);
            if (option.selected) opt.prop('selected', true);
            $target.append(opt);
          }
        });
      });
    }

    // Setup exclusion filters for all three pairs
    setupExclusionFilter('#heatmap_x', '#heatmap_y');
    setupExclusionFilter('#condition1-test', '#condition2-test');
    setupExclusionFilter('#condition1-pooled', '#condition2-pooled');

    // Validation for both analyses
    $('#review-button').on('click', function(e) {
      var testHypothesisChecked = $("input[name='chart_types[]'][value='test-hypothesis']").is(":checked");
      var compareParametersChecked = $("input[name='chart_types[]'][value='compare-parameters']").is(":checked");
      
      // Test Hypothesis validation
      if (testHypothesisChecked) {
        var columnTestSelected = $("#column-test").val();
        var condition1TestSelected = $("#condition1-test").val();
        var condition2TestSelected = $("#condition2-test").val();
        
        if (!columnTestSelected || !condition1TestSelected || !condition2TestSelected) {
          e.preventDefault();
          alert("Please select a variable and conditions to compare on for the 'Test Hypothesis' analysis.");
          return;
        }
      }
      
      // Compare Growth validation
      if (compareParametersChecked) {
        var columnPooledSelected = $("#column-pooled").val();
        var condition1PooledSelected = $("#condition1-pooled").val();
        var condition2PooledSelected = $("#condition2-pooled").val();
        
        if (!columnPooledSelected || !condition1PooledSelected || !condition2PooledSelected) {
          e.preventDefault();
          alert("Please select a variable and conditions to compare on for the 'Compare Growth' analysis.");
          return;
        }
      }
      
      // Fit Statistics validation
      var poolReplicates = $("input[name='pool_replicates']:checked").val();
      var selectedOptions = $("input[name='pool_options[]']:checked").length;
      if (poolReplicates === 'yes' && selectedOptions === 0) {
        e.preventDefault();
        alert("Please select at least one parameter to pool on for the Fit Statistics analysis, or select 'No'.");
      }
    });

    // Initialize form visibility based on session data
    // If GP plot is selected, show its containers
    if ($("input[name='chart_types[]'][value='gp_plot']").is(":checked")) {
      $(".gp-pool-by-container").show();
      $(".gp-subset-toggle").show();
      if ($("#gp_subset_yes").is(":checked")) {
        $(".gp-subset-container").show();
      }
    }

    // If Fit Stats is selected, show its containers
    if ($("input[name='chart_types[]'][value='fit_stats']").is(":checked")) {
      $(".radio-container").show();
      if ($("input[name='pool_replicates']:checked").val() === 'yes') {
        $(".checkbox-container").show();
      }
    }

    // If Heatmap is selected, show its containers
    if ($("input[name='chart_types[]'][value='heatmap_plot']").is(":checked")) {
      $(".heatmap-container").show();
    }

    // If Test Hypothesis is selected, show its containers and populate condition dropdowns
    if ($("input[name='chart_types[]'][value='test-hypothesis']").is(":checked")) {
      $(".test-hypothesis-container").show();
      const columnTest = $("#column-test").val();
      if (columnTest) {
        generateSubsetDropdowns(columnTest, "test", "test");
      }
    }

    // If Compare Parameters is selected, show its containers and populate condition dropdowns
    if ($("input[name='chart_types[]'][value='compare-parameters']").is(":checked")) {
      $(".compare-parameters-container").show();
      const columnPooled = $("#column-pooled").val();
      if (columnPooled) {
        generateSubsetDropdowns(columnPooled, "pooled", "pooled");
      }
    }

    // Hide Fit Stats options initially
    $(".checkbox-container").hide();

    // Handle "No" and "Yes" radio button change events
    $("input[name='pool_replicates']").on("change", function() {
      if ($(this).val() === "yes") {
        $(".checkbox-container").show();
      } else {
        $(".checkbox-container").hide();
        clearCheckedOptions();
      }
    });

    function clearCheckedOptions() {
      $("input[name='pool_options[]']").prop("checked", false);
    }
  });
</script>

</body>
</html> 
