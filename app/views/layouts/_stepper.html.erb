<%#
  Locals: current_step (1-based) and optional steps, a list of [name, path].
  A step links to its path once reached; a nil path is never a link.
  Without steps, the growth analysis steps are shown.
%>
<% steps = local_assigns[:steps] || [
     ["Upload Files", upload_path],
     ["Select Analyses", selectanalyses_path],
     ["Review", review_path],
     ["Submit", nil]
   ] %>
<div class="stepper-wrapper">
  <% steps.each.with_index(1) do |(name, path), number| %>
    <div class="stepper-item <%= 'active' if current_step == number %> <%= 'completed' if current_step > number %>">
      <% if path && (number == 1 || current_step >= number) %>
        <a href="<%= path %>">
          <div class="step-counter"><%= number %></div>
          <div class="step-name"><%= name %></div>
        </a>
      <% else %>
        <div class="step-counter"><%= number %></div>
        <div class="step-name"><%= name %></div>
      <% end %>
    </div>
  <% end %>
</div>
