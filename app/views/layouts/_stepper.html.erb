<div class="stepper-wrapper">
  <div class="stepper-item <%= 'active' if current_step == 1 %> <%= 'completed' if current_step > 1 %>">
    <a href="<%= upload_path %>">
      <div class="step-counter">1</div>
      <div class="step-name">Upload Files</div>
    </a>
  </div>
  <div class="stepper-item <%= 'active' if current_step == 2 %> <%= 'completed' if current_step > 2 %>">
    <% if current_step >= 2 %>
      <a href="<%= selectanalyses_path %>">
        <div class="step-counter">2</div>
        <div class="step-name">Select Analyses</div>
      </a>
    <% else %>
      <div class="step-counter">2</div>
      <div class="step-name">Select Analyses</div>
    <% end %>
  </div>
  <div class="stepper-item <%= 'active' if current_step == 3 %> <%= 'completed' if current_step > 3 %>">
    <% if current_step >= 3 %>
      <a href="<%= review_path %>">
        <div class="step-counter">3</div>
        <div class="step-name">Review</div>
      </a>
    <% else %>
      <div class="step-counter">3</div>
      <div class="step-name">Review</div>
    <% end %>
  </div>
  <div class="stepper-item <%= 'active' if current_step == 4 %>">
    <div class="step-counter">4</div>
    <div class="step-name">Submit</div>
  </div>
</div>
