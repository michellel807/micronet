<!DOCTYPE html>
<html>

<head>
  <title>Feedbacks page</title>
  <%= stylesheet_link_tag 'feedbacks' %>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>

<body>
<div class="feedbacksscreen">

<h1>Submit Feedback</h1>
<p> We are continually improving the Schmid Lab Microbial Growth Model based on user feedback. If you have any questions, concerns, or suggestions for how the site could be improved, please submit them below. </p>
<%= form_with(model: @feedback, url: feedbacks_path, method: :post) do |form| %>
  <% if @feedback.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@feedback.errors.count, "error") %> prohibited this feedback from being 
saved:</h2>
      <ul>
        <% @feedback.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div class="field">
    <%= form.label :email %>
    <%= form.email_field :email %>
  </div>

  <div class="field">
    <%= form.label :message %>
    <%= form.text_area :message %>
  </div>

  <div class="actions">
    <%= form.submit "Submit" %>
  </div>
<% end %>
</div>
</body>