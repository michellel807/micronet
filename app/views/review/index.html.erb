<!DOCTYPE html>
<html>
<head>
  <title>Parameter page</title>
  <%= stylesheet_link_tag 'parameter' %>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>
  <div class="parameterscreen">
    <%= render "layouts/header" %>

    <div class="column skinny">
    <div class="stepper-wrapper">
    <div class="stepper-item completed">
      <a href="<%= upload_path %>" style="text-decoration: none; color: white"> 
        <div class="step-counter completed">1</div>
      </a>
        <div class="step-name">Upload Files</div>
    </div>
    <div class="stepper-item completed">
      <a href="<%= selectanalyses_path %>"style="text-decoration: none; color: white">
        <div class="step-counter">2</div>
      </a>
      <div class="step-name">Select Analyses</div>
    </div>
    <div class="stepper-item active">
      <div class="step-counter">3</div>
      <a href="<%= review_path %>"style="text-decoration: none; color: white"> </a>
      <div class="step-name">Review</div>
    </div>
    <div class="stepper-item">
      <div class="step-counter">4</div>
      <div class="step-name">Submit</div>
    </div>
  </div>

      <% content_for :title, "Parameters page" %>
      <%= form_with url: '/generate', method: :post do |form| %>
      <h1>Review and Submit</h1>
      <p>Please verify that your details are correct before submitting. When you click "Start My Job," you will receive an email confirming your submission.</p>
      <div class="general-white-block">

        <h2>Email</h2>
        <p><%= @user.email %></p>
        <%= link_to 'Edit', root_path, class: 'edit-button' %>

        <h2>Uploaded Files</h2>

        <% if @usr_data_file_names.present? %>
          <p><strong>Data Files:</strong> <%= @usr_data_file_names.join(", ") %></p>
        <% end %>

        <% if @usr_mapping_file_names.present? %>
          <p><strong>Mapping Files:</strong> <%= @usr_mapping_file_names.join(", ") %></p>
        <% end %>

        <% if @usr_meta_file_name.present? %>
          <p><strong>Meta File:</strong> <%= @usr_meta_file_name %></p>
        <% end %>

        <% if @usr_interval_file_name.present? %>
          <p><strong>Interval File:</strong> <%= @usr_interval_file_name %></p>
        <% end %>
        <%= link_to 'Edit', upload_path, class: 'edit-button' %>

        <h2>Analyses To Run</h2>

        <% if session[:chart_types].blank? || session[:chart_types] == [""] %>
          <p>No analyses selected.</p>
        <% else %>

          <% if session[:chart_types].include?('raw_data') %>
            <p>Raw Data Plots (Per Well)</p>
          <% else %>
            <p>N/A (Raw data plots not requested)</p>
          <% end %>

          <% if session[:chart_types].include?('gp_plot') %>
            <% if session[:gp_pool_by_column].present? %>
              <% if session[:gp_subset_choice] == "yes" && session[:gp_subset_column].present? %>
                <p>Gaussian Pocess Plot (Pooled by <%= session[:gp_pool_by_column] %> and Subset on <%= session[:gp_subset_column] %>)</p>
              <% elsif session[:gp_subset_choice] == "no" %>
                <p>Gaussian Pocess Plot (Pooled by <%= session[:gp_pool_by_column] %>)</p>
              <% else %>
                <p>Gaussian Process Plot (Pooled by <%= session[:gp_pool_by_column] %> but no subset specified)</p>
              <% end %>
            <% else %>
              <p>Gaussian Process Plot (No pooling specified)</p>
            <% end %>
          <% else %>
            <p>N/A (Growth curve plot not requested)</p>
          <% end %>

          <% if session[:chart_types].include?('fit_stats') %>
            <% if session[:pool_replicates] == "yes" && session[:pool_options].present? %>
              <p>Fit Statistics (Pool by <%= session[:pool_options].join(", ") %>)</p>
            <% elsif session[:pool_replicates] == "no" %>
              <p>Fit Statistics (No pooling)</p>
            <% else %>
              <p>Pooling information not provided.</p>
            <% end %>
          <% else %>
            <p>N/A (Fit statistics not requested)</p>
          <% end %>

          <% if session[:chart_types].include?('test-hypothesis') %>
            <% if session[:test_final].present? %>
              <p>Test Hypothesis (Test on <%= session[:column_test] %> and Subset on <%= session[:test_final] %>)</p>
            <% else %>
              <p>Test Hypothesis (Test on <%= session[:column_test] %>)</p>
            <% end %>
          <% else %>
            <p>N/A (Test hypothesis not requested)</p>
          <% end %>

          <% if session[:chart_types].include?('compare-parameters') %>
            <% if session[:compare_final].present? %>
              <p>Compare Growth (Compare by <%= session[:column_pooled] %> and Subset on <%= session[:compare_final] %>)</p>
            <% else %>
              <p>Compare Growth (Compare by <%= session[:column_pooled] %>)</p>
            <% end %>
          <% else %>
            <p>N/A (Compare growth not requested)</p>
          <% end %>
        <%= link_to 'Edit', selectanalyses_path, class: 'edit-button' %>

        <%= submit_tag 'Start My Job', class: 'analysis-button' %>
        <p style="margin-top: 10px;"> Note: Submitting may take a few seconds. Please be patient. </p>
        <% end %>
      <% end %>
      </div>
    </div>
    <%= render "layouts/footer" %>
  </div>
  <div class="background-space"></div>
</body>
</html>
