<!DOCTYPE html>
<html>
<head>
  <title>Parameter page</title>
  <%= stylesheet_link_tag 'parameter' %>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>
  <div class="parameterscreen">
    <header>
      <a href="https://genome.duke.edu/">
        <%= image_tag 'logo.png', alt: 'Duke Logo' %>
      </a>
      <a class = "home_link" href="/"><h2 style = "color:white;" >THE SCHMID LAB MICROBIAL GROWTH MODEL</h2></a>
      <nav>
        <a class="wel_nav" href="/help">HELP</a>
        <a class="wel_nav" href="/resources">RESOURCES</a>
        <a class="wel_nav" href="/admin">ADMIN</a>
      </nav>
    </header>

    <div class="column skinny">
      <% content_for :title, "Parameters page" %>
      <%= form_with url: '/generate', method: :post do |form| %>
      <h1>Review and Submit</h1>
      <p>Please verify that your details are correct before submitting. When you click "Start My Job," you will receive an email confirming your submission.</p>
      <div class="general-white-block">

        <h2>Email</h2>
        <p><%= @user.email %></p>

        <h2>Data Files</h2>
        <% @data_file_names.each do |data_file| %>
          <p><%= data_file %></p>
        <% end %>
        <%= link_to 'Edit', upload_path, class: 'edit-button' %>


        <h2>Mapping Files</h2>
        <% @mapping_file_names.each do |mapping_file_path| %>
          <p><%= mapping_file_path %></p>
        <% end %>
        <%= link_to 'Edit', upload_path, class: 'edit-button' %>

        <h2>Analyses To Run</h2>
        <% session[:chart_types].each do |chart_type| %>
          <% if chart_type == 'fit_stats' %>
            <p>Fit Statistics</p>
          <% elsif chart_type == 'raw_data' %>
            <p>Raw Data Plots (Per Well)</p>
          <% elsif chart_type == 'compare-parameters' %>
            <p>Compare Growth in Different Conditions</p>
          <% elsif chart_type != 'fit_stats' && chart_type != 'raw_data' && chart_type != 'compare-parameters' %>
          <p>No analyses selected.</p>
          <% end %>
        <% end %>
        <%= link_to 'Edit', selectanalyses_path, class: 'edit-button' %>

        <h2>Pool Replicates: Selected Options</h2>
        <% if session[:chart_types].include?('fit_stats') && session[:pool_replicates] == "yes" && !session[:pool_options].empty? %>
          <p>For fit statistics, replicates will be pooled by <%= session[:pool_options] %></p>
        <% elsif session[:chart_types].include?('fit_stats') && session[:pool_replicates] == "no" %>
          <p>For fit statistics, no pooling will be used.</p>
        <% elsif !session[:chart_types].include?('fit_stats') %>
        <p>N/A (Fit statistics not requested)</p>
        <% end %>
        <%= link_to 'Edit', selectanalyses_path, class: 'edit-button' %>

        <h2>Compare Growth: Selected Options</h2>
        <% if session[:chart_types].include?('compare-parameters') && session[:subsetoptions].present?%>
          <p>Growth will be compared by <%= session[:column] %> and subset on <%= session[:subsetoptions] %></p>
          <% elsif session[:chart_types].include?('compare-parameters') && !session[:subsetoptions].present?%>
          <p>Growth will be compared by <%= session[:column] %>. </p>
          <% elsif !session[:chart_types].include?('compare-parameters')%>
          <p>N/A (Compare growth not requested)</p>
        <% end %>
        <%= link_to 'Edit', selectanalyses_path, class: 'edit-button' %>

        <%= submit_tag 'Start My Job', class: 'analysis-button' %>
        <p style="margin-top: 10px;"> Note: Submitting may take a few seconds. Please be patient. </p>
        <% end %>
      </div>
    </div>
    <footer>
      <a href="https://duke.edu"><img src="https://software.duke.edu/sites/default/themes/slic/logo.svg" alt="Duke University Logo"/></a>
      <h2 style="margin-top:10px">&copy; Schmid Lab 2023</h2>
      <br/>
    </footer>
  </div>
  <div class="background-space"></div>
</body>
</html>
