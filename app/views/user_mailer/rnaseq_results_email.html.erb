<% genes = @manifest["genes"] %>
<% baseline = @clustering && @clustering["silhouette_baseline"] %>
<p>Hello,</p>

<p>Your RNA-seq analysis (Job #<%= @job.job_number %>) is complete.</p>

<p><strong>Analysis:</strong> <%= @question %></p>

<p style="margin-bottom:0;"><strong>Results</strong></p>
<ul style="margin-top:0;">
  <li>Samples analyzed: <%= number_with_delimiter(@manifest["samples"]["in_model"]) %></li>
  <li>Genes tested: <%= number_with_delimiter(genes["tested"]) %> of <%= number_with_delimiter(genes["in_input"]) %></li>
  <li>Significant genes: <strong><%= number_with_delimiter(genes["significant"]) %></strong><% unless genes["significant_up"].nil? %> (<%= number_with_delimiter(genes["significant_up"]) %> higher and <%= number_with_delimiter(genes["significant_down"]) %> lower in <%= @manifest.dig("contrast", "test_level") %>)<% end %></li>
  <% if @clustering %>
    <li>Gene clusters: <%= @clustering["clusters"] %> (silhouette <%= format("%.2f", @clustering["silhouette"]) %>)</li>
  <% end %>
  <% if baseline %>
    <li>Silhouette reliability check: actual <%= format("%.2f", baseline["actual"]) %>, shuffled baseline <%= format("%.2f", baseline["shuffled_mean"]) %>, difference <%= format("%+.2f", baseline["difference"]) %> (near 0 would mean no better than random patterns)</li>
  <% end %>
</ul>

<p>Statistical method: <%= @method %></p>

<p><strong>Attached:</strong> <%= @file_names.join(", ") %></p>

<% if @warnings.present? %>
  <p><strong>Please note</strong></p>
  <ul>
    <% @warnings.each do |warning| %>
      <li><%= warning[:analysis] %>: <%= warning[:message] %></li>
    <% end %>
  </ul>
<% end %>

<p>The ZIP contains your results and plots. See README.txt for file descriptions, analysis settings, and statistical methods. Related papers are available on MicroNet’s Resources page.</p>

<p>
  Best,<br>
  The MicroNet Team<br>
  schmidlabmodel@gmail.com
</p>
