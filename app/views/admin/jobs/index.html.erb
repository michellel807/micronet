<% content_for :title, "Jobs — Admin" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "admin", "admin-jobs", "data-turbo-track": "reload" %>
<% end %>

<div class="adm-shell">

  <%# ── Top Bar ──────────────────────────────────────────── %>
  <div class="adm-topbar">
    <div class="topbar-brand">
      <span class="topbar-wordmark">MicroNet</span>
      <span class="topbar-sep"></span>
      <span class="topbar-sub">Admin Console</span>
    </div>
    <div class="topbar-right">
      <div class="adm-chip">
        <span class="adm-dot"></span>
        Admin
      </div>
      <%= button_to "Log out", admin_logout_path,
            method: :delete,
            data: { confirm: "Log out of admin console?" },
            class: "topbar-logout",
            form: { style: "display:inline" } %>
    </div>
  </div>

  <%# ── Main Content ─────────────────────────────────────── %>
  <div class="adm-content">

    <%# Page header %>
    <div class="pg-header">
      <div>
        <h1 class="pg-title">Jobs Management</h1>
        <p class="pg-sub">Monitor and manage analysis jobs across the platform</p>
      </div>
      <button class="btn-refresh" onclick="location.reload()">
        <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M13.65 2.35A8 8 0 1 0 15 8h-2a6 6 0 1 1-1.03-3.37L10 6h5V1l-1.35 1.35z"/></svg>
        Refresh
      </button>
    </div>

    <%# Stat cards — also serve as tab navigation %>
    <%
      _active_jobs    = @jobs.select { |j| ["Job submitted","Analyzing..."].include?(j.status) }
      _completed_jobs = @jobs.select { |j| ["Completed", "Completed with warnings"].include?(j.status) && j.updated_at >= 7.days.ago }
      _failed_jobs    = @jobs.select { |j| j.status == "Failed"     && j.updated_at >= 7.days.ago }
      _cancelled_jobs = @jobs.select { |j| j.status == "Cancelled"  && j.updated_at >= 7.days.ago }
    %>
    <div class="stat-grid">
      <div class="stat-card sel" data-filter="all">
        <div class="stat-label">All Jobs</div>
        <div class="stat-value"><%= @jobs.count %></div>
      </div>
      <div class="stat-card" data-filter="active">
        <div class="stat-label">Active</div>
        <div class="stat-value"><%= _active_jobs.count %></div>
      </div>
      <div class="stat-card" data-filter="completed">
        <div class="stat-label">Completed (7d)</div>
        <div class="stat-value"><%= _completed_jobs.count %></div>
      </div>
      <div class="stat-card" data-filter="failed">
        <div class="stat-label">Failed (7d)</div>
        <div class="stat-value"><%= _failed_jobs.count %></div>
      </div>
      <div class="stat-card" data-filter="cancelled">
        <div class="stat-label">Cancelled (7d)</div>
        <div class="stat-value"><%= _cancelled_jobs.count %></div>
      </div>
    </div>

    <%# ── All Jobs ─────────────────────────────────────────── %>
    <div id="all" class="section active">
      <div class="tcard">
        <div class="tcard-head">
          <span class="tcard-title">All Jobs <span class="tcard-count">(<%= @jobs.count %>)</span></span>
          <button class="btn-clear" onclick="clearActive()">Clear view</button>
        </div>
        <% if @jobs.any? %>
          <div class="tscroll">
            <table id="all-table" class="dtable">
              <thead>
                <tr>
                  <th>Researcher</th>
                  <th>Job ID</th>
                  <th>Status</th>
                  <th>Submitted</th>
                  <th>Started</th>
                  <th>Ended</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% @jobs.sort_by(&:created_at).reverse.each do |job| %>
                  <% pc = case job.status
                       when "In Progress"    then "draft"
                       when "Job submitted"  then "queued"
                       when "Analyzing..."   then "running"
                       when "Completed", "Completed with warnings" then "completed"
                       when "Failed"         then "failed"
                       when "Cancelled"      then "cancelled"
                       else "draft" end
                     pl = case job.status
                       when "In Progress"   then "Draft"
                       when "Job submitted" then "Queued"
                       when "Analyzing..."  then "Running"
                       else job.status end %>
                  <tr>
                    <td><span class="c-email"><%= job.user.email %></span></td>
                    <td><span class="c-id">#<%= job.job_number %></span></td>
                    <td><span class="pill <%= pc %>"><%= pl %></span></td>
                    <td><span class="c-time"><%= (job.confirm_time || job.created_at).strftime("%b %d, %Y %H:%M") %></span></td>
                    <td><%= job.start_time.present? ? content_tag(:span, job.start_time.strftime("%b %d, %Y %H:%M"), class: "c-time") : content_tag(:span, "—", class: "c-nil") %></td>
                    <td><%= job.end_time.present?   ? content_tag(:span, job.end_time.strftime("%b %d, %Y %H:%M"),   class: "c-time") : content_tag(:span, "—", class: "c-nil") %></td>
                    <td>
                      <% if ["Job submitted","Analyzing..."].include?(job.status) && job.admin_can_manage_jobs?(current_admin) %>
                        <button class="btn-cancel-row" onclick="showCancelModal(<%= job.id %>, <%= job.user.email.to_json %>, <%= job.job_number %>)">Cancel</button>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="empty">
            <div class="empty-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6M9 12h6M9 15h4"/></svg></div>
            <div class="empty-title">No jobs found</div>
            <div class="empty-sub">Analysis jobs will appear here once submitted</div>
          </div>
        <% end %>
      </div>
    </div>

    <%# ── Active Jobs ──────────────────────────────────────── %>
    <div id="active" class="section">
      <div class="tcard">
        <div class="tcard-head">
          <span class="tcard-title">Active Jobs <span class="tcard-count">(<%= _active_jobs.count %>)</span></span>
          <button class="btn-clear" onclick="clearActive()">Clear view</button>
        </div>
        <% active_sorted = _active_jobs.sort_by(&:created_at).reverse %>
        <% if active_sorted.any? %>
          <div class="tscroll">
            <table id="active-table" class="dtable">
              <thead>
                <tr>
                  <th>Researcher</th>
                  <th>Job ID</th>
                  <th>Status</th>
                  <th>Submitted</th>
                  <th>Started</th>
                  <th>Queue #</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% active_sorted.each_with_index do |job, i| %>
                  <tr>
                    <td><span class="c-email"><%= job.user.email %></span></td>
                    <td><span class="c-id">#<%= job.job_number %></span></td>
                    <td><span class="pill <%= job.status == "Job submitted" ? "queued" : "running" %>"><%= job.status == "Job submitted" ? "Queued" : "Running" %></span></td>
                    <td><span class="c-time"><%= (job.confirm_time || job.created_at).strftime("%b %d, %Y %H:%M") %></span></td>
                    <td><%= job.start_time.present? ? content_tag(:span, job.start_time.strftime("%b %d, %Y %H:%M"), class: "c-time") : content_tag(:span, "—", class: "c-nil") %></td>
                    <td><%= job.status == "Job submitted" ? content_tag(:span, i + 1, class: "q-rank") : content_tag(:span, "—", class: "c-nil") %></td>
                    <td>
                      <% if job.admin_can_manage_jobs?(current_admin) %>
                        <button class="btn-cancel-row" onclick="showCancelModal(<%= job.id %>, <%= job.user.email.to_json %>, <%= job.job_number %>)">Cancel</button>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="empty">
            <div class="empty-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></div>
            <div class="empty-title">No active jobs</div>
            <div class="empty-sub">The queue is clear — no jobs running or pending</div>
          </div>
        <% end %>
      </div>
    </div>

    <%# ── Completed ────────────────────────────────────────── %>
    <div id="completed" class="section">
      <div class="tcard">
        <div class="tcard-head">
          <span class="tcard-title">Completed Jobs <span class="tcard-count">(last 7 days · <%= _completed_jobs.count %>)</span></span>
          <button class="btn-clear" onclick="clearActive()">Clear view</button>
        </div>
        <% completed_sorted = _completed_jobs.sort_by(&:updated_at).reverse %>
        <% if completed_sorted.any? %>
          <div class="tscroll">
            <table id="completed-table" class="dtable">
              <thead>
                <tr>
                  <th>Researcher</th>
                  <th>Job ID</th>
                  <th>Submitted</th>
                  <th>Started</th>
                  <th>Ended</th>
                  <th>Duration</th>
                </tr>
              </thead>
              <tbody>
                <% completed_sorted.each do |job| %>
                  <tr>
                    <td><span class="c-email"><%= job.user.email %></span></td>
                    <td><span class="c-id">#<%= job.job_number %></span></td>
                    <td><span class="c-time"><%= (job.confirm_time || job.created_at).strftime("%b %d, %Y %H:%M") %></span></td>
                    <td><%= job.start_time.present? ? content_tag(:span, job.start_time.strftime("%b %d, %Y %H:%M"), class: "c-time") : content_tag(:span, "—", class: "c-nil") %></td>
                    <td><%= job.end_time.present?   ? content_tag(:span, job.end_time.strftime("%b %d, %Y %H:%M"),   class: "c-time") : content_tag(:span, "—", class: "c-nil") %></td>
                    <td>
                      <% if job.start_time.present? && job.end_time.present? %>
                        <span class="c-dur"><%= ((job.end_time - job.start_time) / 60).round(1) %> min</span>
                      <% else %>
                        <span class="c-nil">—</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="empty">
            <div class="empty-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 6L9 17l-5-5"/></svg></div>
            <div class="empty-title">No completed jobs</div>
            <div class="empty-sub">No jobs completed in the last 7 days</div>
          </div>
        <% end %>
      </div>
    </div>

    <%# ── Failed ───────────────────────────────────────────── %>
    <div id="failed" class="section">
      <div class="tcard">
        <div class="tcard-head">
          <span class="tcard-title">Failed Jobs <span class="tcard-count">(last 7 days · <%= _failed_jobs.count %>)</span></span>
          <button class="btn-clear" onclick="clearActive()">Clear view</button>
        </div>
        <% failed_sorted = _failed_jobs.sort_by(&:updated_at).reverse %>
        <% if failed_sorted.any? %>
          <div class="tscroll">
            <table id="failed-table" class="dtable">
              <thead>
                <tr>
                  <th>Researcher</th>
                  <th>Job ID</th>
                  <th>Submitted</th>
                  <th>Started</th>
                  <th>Failed At</th>
                </tr>
              </thead>
              <tbody>
                <% failed_sorted.each do |job| %>
                  <tr>
                    <td><span class="c-email"><%= job.user.email %></span></td>
                    <td><span class="c-id">#<%= job.job_number %></span></td>
                    <td><span class="c-time"><%= (job.confirm_time || job.created_at).strftime("%b %d, %Y %H:%M") %></span></td>
                    <td><%= job.start_time.present? ? content_tag(:span, job.start_time.strftime("%b %d, %Y %H:%M"), class: "c-time") : content_tag(:span, "—", class: "c-nil") %></td>
                    <td><%= job.end_time.present?   ? content_tag(:span, job.end_time.strftime("%b %d, %Y %H:%M"),   class: "c-time") : content_tag(:span, "—", class: "c-nil") %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="empty">
            <div class="empty-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M15 9l-6 6M9 9l6 6"/></svg></div>
            <div class="empty-title">No failed jobs</div>
            <div class="empty-sub">No jobs failed in the last 7 days</div>
          </div>
        <% end %>
      </div>
    </div>

    <%# ── Cancelled ────────────────────────────────────────── %>
    <div id="cancelled" class="section">
      <div class="tcard">
        <div class="tcard-head">
          <span class="tcard-title">Cancelled Jobs <span class="tcard-count">(last 7 days · <%= _cancelled_jobs.count %>)</span></span>
          <button class="btn-clear" onclick="clearActive()">Clear view</button>
        </div>
        <% cancelled_sorted = _cancelled_jobs.sort_by(&:updated_at).reverse %>
        <% if cancelled_sorted.any? %>
          <div class="tscroll">
            <table id="cancelled-table" class="dtable">
              <thead>
                <tr>
                  <th>Researcher</th>
                  <th>Job ID</th>
                  <th>Submitted</th>
                  <th>Cancelled At</th>
                </tr>
              </thead>
              <tbody>
                <% cancelled_sorted.each do |job| %>
                  <tr>
                    <td><span class="c-email"><%= job.user.email %></span></td>
                    <td><span class="c-id">#<%= job.job_number %></span></td>
                    <td><span class="c-time"><%= (job.confirm_time || job.created_at).strftime("%b %d, %Y %H:%M") %></span></td>
                    <td><%= job.end_time.present? ? content_tag(:span, job.end_time.strftime("%b %d, %Y %H:%M"), class: "c-time") : content_tag(:span, "—", class: "c-nil") %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="empty">
            <div class="empty-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg></div>
            <div class="empty-title">No cancelled jobs</div>
            <div class="empty-sub">No jobs cancelled in the last 7 days</div>
          </div>
        <% end %>
      </div>
    </div>

    <%# ── Change username or password ─────────────────────────────────── %>
    <div class="settings-wrap">
      <button class="settings-toggle" id="stg-toggle">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"/></svg>
        Change username or password?
        <svg class="toggle-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="settings-body" id="stg-body">
        <div class="creds-grid">
          <div class="cred-card">
            <div class="cred-card-title">Change Username</div>
            <%= form_tag(update_admin_username_path, method: :patch) do %>
              <div class="form-field">
                <label class="form-lbl">Current Password</label>
                <%= password_field_tag :current_password, '', class: 'form-inp', placeholder: '••••••••' %>
              </div>
              <div class="form-field">
                <label class="form-lbl">New Username</label>
                <%= text_field_tag :new_username, '', class: 'form-inp', placeholder: 'Enter new username' %>
              </div>
              <%= submit_tag 'Update Username', class: 'btn-primary' %>
            <% end %>
            <% if flash.now[:error]&.include?('username') %>
              <div class="form-msg err"><%= flash.now[:error] %></div>
            <% end %>
            <% if flash.now[:success]&.include?('Username') %>
              <div class="form-msg ok"><%= flash.now[:success] %></div>
            <% end %>
          </div>
          <div class="cred-card">
            <div class="cred-card-title">Change Password</div>
            <%= form_tag(update_admin_password_path, method: :patch) do %>
              <div class="form-field">
                <label class="form-lbl">Current Password</label>
                <%= password_field_tag :current_password, '', class: 'form-inp', placeholder: '••••••••' %>
              </div>
              <div class="form-field">
                <label class="form-lbl">New Password</label>
                <%= password_field_tag :new_password, '', class: 'form-inp', placeholder: '••••••••' %>
              </div>
              <div class="form-field">
                <label class="form-lbl">Confirm New Password</label>
                <%= password_field_tag :password_confirmation, '', class: 'form-inp', placeholder: '••••••••' %>
              </div>
              <%= submit_tag 'Update Password', class: 'btn-primary' %>
            <% end %>
            <% if flash.now[:error]&.include?('password') %>
              <div class="form-msg err"><%= flash.now[:error] %></div>
            <% end %>
            <% if flash.now[:success]&.include?('Password') %>
              <div class="form-msg ok"><%= flash.now[:success] %></div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

  </div><%# /adm-content %>

  <%= render "layouts/footer" %>
</div><%# /adm-shell %>

<%# ── Cancel Modal ──────────────────────────────────────────── %>
<div id="cancelModal" class="modal-bg" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div class="modal-box">
    <div class="modal-hd">
      <div class="modal-ttl" id="modal-title">Cancel Job</div>
    </div>
    <div class="modal-bd">
      <p>You are about to cancel the following job. This action cannot be undone.</p>
      <div class="modal-row">
        <span class="modal-lbl">Job ID</span>
        <span class="modal-val" id="jobIdConfirm"></span>
      </div>
      <div class="modal-row">
        <span class="modal-lbl">Researcher</span>
        <span class="modal-val" id="userEmailConfirm"></span>
      </div>
      <div class="modal-warn">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;margin-top:1px"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        The researcher will receive an email notification when this job is cancelled.
      </div>
    </div>
    <div class="modal-ft">
      <button class="btn-keep" onclick="closeModal()">Keep Job</button>
      <button class="btn-confirm-cancel" id="confirmCancelBtn">Cancel Job</button>
    </div>
  </div>
</div>

<script>
  function clearActive() {
    const sec = document.querySelector('.section.active');
    if (sec) { const tb = sec.querySelector('tbody'); if (tb) tb.innerHTML = ''; }
  }

  function showCancelModal(jobId, userEmail, jobNumber) {
    document.getElementById('jobIdConfirm').innerText = '#' + jobNumber;
    document.getElementById('userEmailConfirm').innerText = userEmail;
    document.getElementById('confirmCancelBtn').onclick = function() { confirmCancel(jobId); };
    document.getElementById('cancelModal').classList.add('open');
  }

  function closeModal() {
    document.getElementById('cancelModal').classList.remove('open');
  }

  function confirmCancel(jobId) {
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = `/admin/jobs/${jobId}/cancel`;
    const mi = document.createElement('input'); mi.type = 'hidden'; mi.name = '_method'; mi.value = 'PATCH'; form.appendChild(mi);
    const ci = document.createElement('input'); ci.type = 'hidden'; ci.name = 'authenticity_token'; ci.value = document.querySelector('meta[name="csrf-token"]').getAttribute('content'); form.appendChild(ci);
    document.body.appendChild(form);
    form.submit();
  }

  document.addEventListener('DOMContentLoaded', function() {
    // Stat card navigation
    const cards    = document.querySelectorAll('.stat-card');
    const sections = document.querySelectorAll('.section');
    cards.forEach(card => {
      card.addEventListener('click', function() {
        cards.forEach(c => c.classList.remove('sel'));
        sections.forEach(s => s.classList.remove('active'));
        this.classList.add('sel');
        document.getElementById(this.dataset.filter).classList.add('active');
      });
    });

    // Settings accordion
    const stgToggle = document.getElementById('stg-toggle');
    const stgBody   = document.getElementById('stg-body');
    stgToggle.addEventListener('click', function() {
      const open = stgBody.classList.toggle('open');
      stgToggle.classList.toggle('open', open);
    });

    // Modal backdrop
    document.getElementById('cancelModal').addEventListener('click', function(e) {
      if (e.target === this) closeModal();
    });

    // Nav guard
    document.querySelectorAll('nav a, .home_link').forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        if (confirm('Please log out before navigating away from the admin page')) {
          if (this.href === 'https://genome.duke.edu/') window.open(this.href, '_blank');
        }
      });
    });
  });
</script>
