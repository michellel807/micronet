<h2>Currently Running Jobs</h2>
<ul>
  <% @jobs.each do |job| %>
    <li>
      <%= "#{job.id}: #{job.title}" %> <!-- Displaying the job number and title -->
      <% if job.admin_can_manage_jobs?(current_admin) %> 
      <%= button_to 'Cancel', cancel_admin_job_path(job), method: :patch, data: { confirm: 'Are you sure you want to cancel this job?' } %>
      <% end %>
    </li>
  <% end %>
</ul>
