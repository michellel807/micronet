<!DOCTYPE html>
<html>
<head>
  <title>Admin page</title>
  <%= stylesheet_link_tag 'admin' %>
  <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
  <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
  <%= csrf_meta_tags %>

</head>
<body>
  <div class="adminscreen">
    <%= render "layouts/header" %>
    <% @jobs = @jobs.to_a.reject { |job| job.status == 'Completed' } %>

    <h1>Currently Running Jobs</h1>
    <ul>
      <% @jobs.each do |job| %>
        <%= "User: #{job.user_id} | "  %>
        <%= "Job: #{job.id} | " %>
        <%= "Status: #{job.status} | " %>
        <%= "Start Time: #{job.start_time} | " %>
        <% if job.admin_can_manage_jobs?(current_admin) %>
        <%= button_to 'Cancel', cancel_admin_job_path(job), method: :patch, class: 'cancel-button', 'data-confirm-message': 'Are you sure you want to cancel this job?' %>
        <% end %>
    <% end %>
  </ul>

  <p id="updateinfo-button">Update username/password </p>

  <div id="credentials-section" style="display: none;">
    <div class="credentials-container">
      <!-- Change Username Form -->
      <div class="credentials-form-wrapper">
        <h2>Change Username</h2>
        <%= form_tag(update_admin_username_path, method: :patch, class: 'credentials-form') do %>
          <div class="form-group">
            <label for="current_password_username">Current Password:</label>
            <%= password_field_tag :current_password, '', class: 'form-control' %>
          </div>

          <div class="form-group">
            <label for="new_username">New Username:</label>
            <%= text_field_tag :new_username, '', class: 'form-control' %>
          </div>

          <%= submit_tag 'Update Username', class: 'form-submit' %>
        <% end %>

        <% if flash.now[:error] && flash.now[:error].include?('username') %>
          <div class="form-error">
            <%= flash.now[:error] %>
          </div>
        <% end %>
        <% if flash.now[:success] && flash.now[:success].include?('Username') %>
          <div class="form-success">
            <%= flash.now[:success] %>
          </div>
        <% end %>
      </div>

      <!-- Change Password Form -->
      <div class="credentials-form-wrapper">
        <h2>Change Password</h2>
        <%= form_tag(update_admin_password_path, method: :patch, class: 'credentials-form') do %>
          <div class="form-group">
            <label for="current_password">Current Password:</label>
            <%= password_field_tag :current_password, '', class: 'form-control' %>
          </div>

          <div class="form-group">
            <label for="new_password">New Password:</label>
            <%= password_field_tag :new_password, '', class: 'form-control' %>
          </div>

          <div class="form-group">
            <label for="password_confirmation">Confirm New Password:</label>
            <%= password_field_tag :password_confirmation, '', class: 'form-control' %>
          </div>

          <%= submit_tag 'Update Password', class: 'form-submit' %>
        <% end %>

        <% if flash.now[:error] && flash.now[:error].include?('password') %>
          <div class="form-error">
            <%= flash.now[:error] %>
          </div>
        <% end %>
        <% if flash.now[:success] && flash.now[:success].include?('Password') %>
          <div class="form-success">
            <%= flash.now[:success] %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%= button_to "Logout", admin_logout_path, method: :delete, data: { confirm: "Are you sure you want to logout?" }, id: "logout-button", class: "logout-button"%>
  </div>
  <%= render "layouts/footer" %>
</body>
<script>
document.addEventListener("DOMContentLoaded", function() {
  var cancelButton = document.querySelector('.cancel-button');
  cancelButton.addEventListener('click', function(event) {
    event.preventDefault();
    var confirmation = confirm(this.dataset.confirmMessage);
    if (confirmation) {
      var form = this.closest('form');
      form.submit(); // Submit the form
    }
  });

  var navLinks = document.querySelectorAll('nav a, .home_link');
  navLinks.forEach(function(link) {
    link.addEventListener('click', function(event) {
      event.preventDefault();
      var confirmation = confirm('Please log out before navigating away from the admin page');
      if (confirmation) {
        if (this.href === 'https://genome.duke.edu/') {
          window.open(this.href, '_blank'); // Open the external link in a new tab
        }
      }
    });
  });


});
window.addEventListener('load', function () {
  const updateButton = document.getElementById('updateinfo-button');
  const credentialsSection = document.getElementById('credentials-section');

  updateButton.addEventListener('click', function() {
    credentialsSection.style.display = (credentialsSection.style.display === 'none') ? 'block' : 'none';
  });
});
</script>

</html>

