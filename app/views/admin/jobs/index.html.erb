<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Jobs — MicroNet Admin</title>
  <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
  <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
  <%= stylesheet_link_tag 'admin' %>
  <%= csrf_meta_tags %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* ── Tokens ──────────────────────────────────────────── */
    :root {
      --duke:          #012169;
      --duke-dk:       #001247;
      --accent:        #0577B1;
      --accent-bg:     #EBF5FB;

      --bg:            #F7F8FA;
      --surface:       #FFFFFF;
      --border:        #E4E7EC;
      --border-sub:    #F1F3F5;

      --tx-1:          #0F172A;
      --tx-2:          #4B5563;
      --tx-3:          #9CA3AF;

      --pill-run-bg:   #EBF5FB; --pill-run-fg:   #0577B1;
      --pill-q-bg:     #F0EDFF; --pill-q-fg:     #6D28D9;
      --pill-dft-bg:   #F3F4F6; --pill-dft-fg:   #6B7280;
      --pill-ok-bg:    #ECFDF5; --pill-ok-fg:    #059669;
      --pill-fail-bg:  #FEF2F2; --pill-fail-fg:  #DC2626;
      --pill-can-bg:   #FFFBEB; --pill-can-fg:   #B45309;

      --sh-xs: 0 1px 2px rgba(0,0,0,.05);
      --sh-sm: 0 1px 3px rgba(0,0,0,.08), 0 1px 2px rgba(0,0,0,.04);
      --sh-md: 0 4px 12px rgba(0,0,0,.08), 0 1px 3px rgba(0,0,0,.05);
      --sh-lg: 0 8px 28px rgba(0,0,0,.10), 0 2px 6px rgba(0,0,0,.05);

      --r-sm: 6px; --r-md: 10px; --r-lg: 14px;
      --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --mono: 'SF Mono', 'Fira Code', ui-monospace, monospace;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      font-family: var(--font);
      background: var(--bg);
      color: var(--tx-1);
      min-height: 100vh;
      font-size: 14px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    /* ── Shell ───────────────────────────────────────────── */
    .adm-shell { display: flex; flex-direction: column; min-height: 100vh; }

    /* ── Topbar ──────────────────────────────────────────── */
    .adm-topbar {
      background: var(--duke);
      height: 52px;
      display: flex;
      align-items: center;
      padding: 0 32px;
      gap: 0;
      border-bottom: 1px solid rgba(255,255,255,0.07);
      position: sticky;
      top: 0;
      z-index: 200;
    }

    .topbar-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 1;
    }

    .topbar-wordmark {
      font-size: 14px;
      font-weight: 700;
      color: #fff;
      letter-spacing: -0.01em;
    }

    .topbar-sep {
      width: 1px;
      height: 16px;
      background: rgba(255,255,255,0.18);
      margin: 0 10px;
    }

    .topbar-sub {
      font-size: 12px;
      color: rgba(255,255,255,0.45);
      font-weight: 400;
    }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .adm-chip {
      display: flex;
      align-items: center;
      gap: 5px;
      padding: 4px 10px;
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 20px;
      font-size: 11px;
      color: rgba(255,255,255,0.6);
      font-weight: 500;
    }

    .adm-dot {
      width: 6px; height: 6px;
      background: #34D399;
      border-radius: 50%;
    }

    .topbar-logout {
      padding: 5px 13px;
      background: transparent;
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: var(--r-sm);
      color: rgba(255,255,255,0.65);
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      font-family: var(--font);
      transition: all 0.15s;
    }

    .topbar-logout:hover {
      background: rgba(255,255,255,0.08);
      border-color: rgba(255,255,255,0.32);
      color: #fff;
    }

    /* ── Content ─────────────────────────────────────────── */
    .adm-content {
      flex: 1;
      max-width: 1280px;
      width: 100%;
      margin: 0 auto;
      padding: 40px 32px 80px;
    }

    /* ── Page Header ─────────────────────────────────────── */
    .pg-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 28px;
    }

    .pg-title {
      font-size: 21px;
      font-weight: 700;
      color: var(--tx-1);
      letter-spacing: -0.02em;
      line-height: 1.2;
    }

    .pg-sub {
      margin-top: 3px;
      font-size: 13px;
      color: var(--tx-3);
    }

    .btn-refresh {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 14px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--r-sm);
      font-size: 12px;
      font-weight: 500;
      color: var(--tx-2);
      cursor: pointer;
      font-family: var(--font);
      transition: all 0.15s;
      flex-shrink: 0;
      box-shadow: var(--sh-xs);
    }

    .btn-refresh:hover {
      background: var(--bg);
      border-color: #CBD5E1;
      color: var(--tx-1);
    }

    /* ── Stat Cards ──────────────────────────────────────── */
    .stat-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 14px;
      margin-bottom: 28px;
    }

    .stat-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--r-md);
      padding: 16px 18px;
      cursor: pointer;
      transition: all 0.15s;
      box-shadow: var(--sh-xs);
      user-select: none;
    }

    .stat-card:hover {
      border-color: #CBD5E1;
      box-shadow: var(--sh-sm);
      transform: translateY(-1px);
    }

    .stat-card.sel {
      border-color: var(--accent);
      background: var(--accent-bg);
      box-shadow: 0 0 0 3px rgba(5,119,177,0.08), var(--sh-sm);
    }

    .stat-label {
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--tx-3);
      margin-bottom: 7px;
    }

    .stat-card.sel .stat-label { color: var(--accent); }

    .stat-value {
      font-size: 26px;
      font-weight: 700;
      color: var(--tx-1);
      letter-spacing: -0.03em;
      line-height: 1;
    }

    .stat-card.sel .stat-value { color: var(--accent); }

    /* ── Table Card ──────────────────────────────────────── */
    .section { display: none; }
    .section.active { display: block; }

    .tcard {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      box-shadow: var(--sh-sm);
      overflow: hidden;
    }

    .tcard-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 20px;
      border-bottom: 1px solid var(--border-sub);
    }

    .tcard-title {
      font-size: 13px;
      font-weight: 600;
      color: var(--tx-1);
    }

    .tcard-count {
      font-size: 12px;
      color: var(--tx-3);
      font-weight: 400;
      margin-left: 5px;
    }

    .btn-clear {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 5px 11px;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: var(--r-sm);
      font-size: 11px;
      font-weight: 500;
      color: var(--tx-3);
      cursor: pointer;
      font-family: var(--font);
      transition: all 0.15s;
    }

    .btn-clear:hover {
      background: var(--pill-fail-bg);
      border-color: #FCA5A5;
      color: var(--pill-fail-fg);
    }

    /* ── Data Table ──────────────────────────────────────── */
    .tscroll {
      max-height: 440px;
      overflow-y: auto;
    }

    .tscroll::-webkit-scrollbar { width: 5px; }
    .tscroll::-webkit-scrollbar-track { background: var(--border-sub); }
    .tscroll::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 10px; }
    .tscroll::-webkit-scrollbar-thumb:hover { background: #94A3B8; }

    .dtable {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    .dtable thead { position: sticky; top: 0; z-index: 2; }

    .dtable th {
      background: var(--surface);
      padding: 9px 16px;
      text-align: left;
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--tx-3);
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }

    .dtable td {
      padding: 12px 16px;
      border-bottom: 1px solid var(--border-sub);
      color: var(--tx-1);
      vertical-align: middle;
    }

    .dtable tbody tr:last-child td { border-bottom: none; }
    .dtable tbody tr { transition: background 0.1s; }
    .dtable tbody tr:hover { background: #F8FAFC; }

    .c-email { font-size: 13px; color: var(--tx-2); }

    .c-id {
      font-family: var(--mono);
      font-size: 11px;
      color: var(--tx-2);
      background: var(--bg);
      padding: 2px 7px;
      border-radius: 4px;
      border: 1px solid var(--border);
      display: inline-block;
    }

    .c-time {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--tx-2);
      white-space: nowrap;
    }

    .c-nil { font-size: 13px; color: var(--tx-3); }

    .c-dur {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--tx-2);
    }

    /* ── Status Pills ────────────────────────────────────── */
    .pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 9px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.01em;
      white-space: nowrap;
    }

    .pill::before {
      content: '';
      width: 5px; height: 5px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .pill.running   { background: var(--pill-run-bg);  color: var(--pill-run-fg);  }
    .pill.queued    { background: var(--pill-q-bg);    color: var(--pill-q-fg);    }
    .pill.draft     { background: var(--pill-dft-bg);  color: var(--pill-dft-fg);  }
    .pill.completed { background: var(--pill-ok-bg);   color: var(--pill-ok-fg);   }
    .pill.failed    { background: var(--pill-fail-bg); color: var(--pill-fail-fg); }
    .pill.cancelled { background: var(--pill-can-bg);  color: var(--pill-can-fg);  }

    .pill.running::before   { background: var(--pill-run-fg);  }
    .pill.queued::before    { background: var(--pill-q-fg);    }
    .pill.draft::before     { background: var(--pill-dft-fg);  }
    .pill.completed::before { background: var(--pill-ok-fg);   }
    .pill.failed::before    { background: var(--pill-fail-fg); }
    .pill.cancelled::before { background: var(--pill-can-fg);  }

    /* ── Action Buttons ──────────────────────────────────── */
    .btn-cancel-row {
      padding: 4px 11px;
      background: transparent;
      border: 1px solid #FCA5A5;
      border-radius: var(--r-sm);
      font-size: 11px;
      font-weight: 500;
      color: var(--pill-fail-fg);
      cursor: pointer;
      font-family: var(--font);
      transition: all 0.15s;
      white-space: nowrap;
    }

    .btn-cancel-row:hover {
      background: var(--pill-fail-bg);
      border-color: var(--pill-fail-fg);
    }

    .q-rank {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 22px; height: 22px;
      background: var(--pill-q-bg);
      color: var(--pill-q-fg);
      border-radius: 50%;
      font-size: 11px;
      font-weight: 700;
    }

    /* ── Empty State ─────────────────────────────────────── */
    .empty {
      padding: 60px 24px;
      text-align: center;
    }

    .empty-icon {
      width: 40px; height: 40px;
      margin: 0 auto 14px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--r-md);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--tx-3);
    }

    .empty-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--tx-2);
      margin-bottom: 3px;
    }

    .empty-sub {
      font-size: 12px;
      color: var(--tx-3);
    }

    /* ── Settings ────────────────────────────────────────── */
    .settings-wrap { margin-top: 40px; }

    .settings-toggle {
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 13px 0;
      cursor: pointer;
      border: none;
      border-top: 1px solid var(--border);
      background: none;
      font-family: var(--font);
      font-size: 13px;
      font-weight: 600;
      color: var(--tx-2);
      transition: color 0.15s;
      width: 100%;
      text-align: left;
    }

    .settings-toggle:hover { color: var(--tx-1); }

    .toggle-chevron {
      margin-left: auto;
      color: var(--tx-3);
      transition: transform 0.2s;
    }

    .settings-toggle.open .toggle-chevron { transform: rotate(180deg); }

    .settings-body { display: none; padding: 20px 0 36px; }
    .settings-body.open { display: block; }

    .creds-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
      gap: 20px;
    }

    .cred-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--r-md);
      padding: 22px;
      box-shadow: var(--sh-xs);
    }

    .cred-card-title {
      font-size: 13px;
      font-weight: 600;
      color: var(--tx-1);
      margin-bottom: 18px;
    }

    .form-field { margin-bottom: 14px; }

    .form-lbl {
      display: block;
      font-size: 11px;
      font-weight: 500;
      color: var(--tx-2);
      margin-bottom: 5px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .form-inp {
      width: 100%;
      padding: 8px 11px;
      border: 1px solid var(--border);
      border-radius: var(--r-sm);
      font-size: 13px;
      font-family: var(--font);
      color: var(--tx-1);
      background: var(--bg);
      outline: none;
      transition: all 0.15s;
    }

    .form-inp:focus {
      border-color: var(--accent);
      background: var(--surface);
      box-shadow: 0 0 0 3px rgba(5,119,177,0.1);
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      padding: 8px 16px;
      background: var(--duke);
      border: 1px solid var(--duke);
      border-radius: var(--r-sm);
      font-size: 13px;
      font-weight: 600;
      color: #fff;
      cursor: pointer;
      font-family: var(--font);
      transition: all 0.15s;
      margin-top: 4px;
    }

    .btn-primary:hover {
      background: var(--duke-dk);
      border-color: var(--duke-dk);
      box-shadow: var(--sh-sm);
    }

    .form-msg {
      margin-top: 10px;
      padding: 9px 12px;
      border-radius: var(--r-sm);
      font-size: 12px;
      font-weight: 500;
    }

    .form-msg.err { background: var(--pill-fail-bg); border: 1px solid #FCA5A5; color: #991B1B; }
    .form-msg.ok  { background: var(--pill-ok-bg);   border: 1px solid #6EE7B7; color: #065F46; }

    /* ── Modal ───────────────────────────────────────────── */
    .modal-bg {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15,23,42,0.4);
      backdrop-filter: blur(3px);
      z-index: 1000;
      align-items: center;
      justify-content: center;
    }

    .modal-bg.open { display: flex; }

    .modal-box {
      background: var(--surface);
      border-radius: var(--r-lg);
      box-shadow: var(--sh-lg);
      width: 100%;
      max-width: 400px;
      margin: 20px;
      overflow: hidden;
      animation: modal-in 0.18s ease;
    }

    @keyframes modal-in {
      from { opacity: 0; transform: scale(0.97) translateY(6px); }
      to   { opacity: 1; transform: scale(1)    translateY(0);   }
    }

    .modal-hd {
      padding: 18px 22px 14px;
      border-bottom: 1px solid var(--border-sub);
    }

    .modal-ttl {
      font-size: 15px;
      font-weight: 700;
      color: var(--tx-1);
    }

    .modal-bd {
      padding: 18px 22px;
    }

    .modal-bd p {
      font-size: 13px;
      color: var(--tx-2);
      line-height: 1.6;
      margin-bottom: 12px;
    }

    .modal-row {
      display: flex;
      gap: 8px;
      padding: 9px 11px;
      background: var(--bg);
      border-radius: var(--r-sm);
      margin-bottom: 5px;
      font-size: 12px;
    }

    .modal-lbl { color: var(--tx-3); font-weight: 500; flex-shrink: 0; width: 68px; }

    .modal-val {
      color: var(--tx-1);
      font-weight: 600;
      font-family: var(--mono);
      word-break: break-all;
    }

    .modal-warn {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      padding: 9px 11px;
      background: var(--pill-can-bg);
      border: 1px solid #FDE68A;
      border-radius: var(--r-sm);
      margin-top: 12px;
      font-size: 12px;
      color: #92400E;
      line-height: 1.5;
    }

    .modal-ft {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      padding: 13px 22px;
      border-top: 1px solid var(--border-sub);
      background: var(--bg);
    }

    .btn-keep {
      padding: 7px 15px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--r-sm);
      font-size: 13px;
      font-weight: 500;
      color: var(--tx-2);
      cursor: pointer;
      font-family: var(--font);
      transition: all 0.15s;
    }

    .btn-keep:hover { background: var(--bg); color: var(--tx-1); border-color: #CBD5E1; }

    .btn-confirm-cancel {
      padding: 7px 15px;
      background: #DC2626;
      border: 1px solid #DC2626;
      border-radius: var(--r-sm);
      font-size: 13px;
      font-weight: 600;
      color: #fff;
      cursor: pointer;
      font-family: var(--font);
      transition: all 0.15s;
    }

    .btn-confirm-cancel:hover { background: #B91C1C; border-color: #B91C1C; box-shadow: var(--sh-sm); }

    /* ── Responsive ──────────────────────────────────────── */
    @media (max-width: 900px) {
      .stat-grid { grid-template-columns: repeat(3, 1fr); }
    }

    @media (max-width: 600px) {
      .adm-topbar { padding: 0 16px; }
      .adm-content { padding: 24px 16px 60px; }
      .stat-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .pg-header { flex-direction: column; gap: 12px; }
      .creds-grid { grid-template-columns: 1fr; }
      .topbar-sub { display: none; }
    }
  </style>
</head>
<body>
<div class="adm-shell">

  <%# ── Top Bar ──────────────────────────────────────────── %>
  <div class="adm-topbar">
    <div class="topbar-brand">
      <span class="topbar-wordmark">MicroNet</span>
      <span class="topbar-sep"></span>
      <span class="topbar-sub">Admin Console</span>
    </div>
    <div class="topbar-right">
      <div class="adm-chip">
        <span class="adm-dot"></span>
        Admin
      </div>
      <%= button_to "Log out", admin_logout_path,
            method: :delete,
            data: { confirm: "Log out of admin console?" },
            class: "topbar-logout",
            form: { style: "display:inline" } %>
    </div>
  </div>

  <%# ── Main Content ─────────────────────────────────────── %>
  <div class="adm-content">

    <%# Page header %>
    <div class="pg-header">
      <div>
        <h1 class="pg-title">Jobs Management</h1>
        <p class="pg-sub">Monitor and manage analysis jobs across the platform</p>
      </div>
      <button class="btn-refresh" onclick="location.reload()">
        <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M13.65 2.35A8 8 0 1 0 15 8h-2a6 6 0 1 1-1.03-3.37L10 6h5V1l-1.35 1.35z"/></svg>
        Refresh
      </button>
    </div>

    <%# Stat cards — also serve as tab navigation %>
    <%
      _active_jobs    = @jobs.select { |j| ["Job submitted","Analyzing..."].include?(j.status) }
      _completed_jobs = @jobs.select { |j| ["Completed", "Completed with warnings"].include?(j.status) && j.updated_at >= 7.days.ago }
      _failed_jobs    = @jobs.select { |j| j.status == "Failed"     && j.updated_at >= 7.days.ago }
      _cancelled_jobs = @jobs.select { |j| j.status == "Cancelled"  && j.updated_at >= 7.days.ago }
    %>
    <div class="stat-grid">
      <div class="stat-card sel" data-filter="all">
        <div class="stat-label">All Jobs</div>
        <div class="stat-value"><%= @jobs.count %></div>
      </div>
      <div class="stat-card" data-filter="active">
        <div class="stat-label">Active</div>
        <div class="stat-value"><%= _active_jobs.count %></div>
      </div>
      <div class="stat-card" data-filter="completed">
        <div class="stat-label">Completed (7d)</div>
        <div class="stat-value"><%= _completed_jobs.count %></div>
      </div>
      <div class="stat-card" data-filter="failed">
        <div class="stat-label">Failed (7d)</div>
        <div class="stat-value"><%= _failed_jobs.count %></div>
      </div>
      <div class="stat-card" data-filter="cancelled">
        <div class="stat-label">Cancelled (7d)</div>
        <div class="stat-value"><%= _cancelled_jobs.count %></div>
      </div>
    </div>

    <%# ── All Jobs ─────────────────────────────────────────── %>
    <div id="all" class="section active">
      <div class="tcard">
        <div class="tcard-head">
          <span class="tcard-title">All Jobs <span class="tcard-count">(<%= @jobs.count %>)</span></span>
          <button class="btn-clear" onclick="clearActive()">Clear view</button>
        </div>
        <% if @jobs.any? %>
          <div class="tscroll">
            <table id="all-table" class="dtable">
              <thead>
                <tr>
                  <th>Researcher</th>
                  <th>Job ID</th>
                  <th>Status</th>
                  <th>Submitted</th>
                  <th>Started</th>
                  <th>Ended</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% @jobs.sort_by(&:created_at).reverse.each do |job| %>
                  <% pc = case job.status
                       when "In Progress"    then "draft"
                       when "Job submitted"  then "queued"
                       when "Analyzing..."   then "running"
                       when "Completed", "Completed with warnings" then "completed"
                       when "Failed"         then "failed"
                       when "Cancelled"      then "cancelled"
                       else "draft" end
                     pl = case job.status
                       when "In Progress"   then "Draft"
                       when "Job submitted" then "Queued"
                       when "Analyzing..."  then "Running"
                       else job.status end %>
                  <tr>
                    <td><span class="c-email"><%= job.user.email %></span></td>
                    <td><span class="c-id">#<%= job.id %></span></td>
                    <td><span class="pill <%= pc %>"><%= pl %></span></td>
                    <td><span class="c-time"><%= job.created_at.strftime("%b %d, %Y %H:%M") %></span></td>
                    <td><%= job.start_time.present? ? content_tag(:span, job.start_time.strftime("%b %d, %Y %H:%M"), class: "c-time") : content_tag(:span, "—", class: "c-nil") %></td>
                    <td><%= job.end_time.present?   ? content_tag(:span, job.end_time.strftime("%b %d, %Y %H:%M"),   class: "c-time") : content_tag(:span, "—", class: "c-nil") %></td>
                    <td>
                      <% if ["Job submitted","Analyzing..."].include?(job.status) && job.admin_can_manage_jobs?(current_admin) %>
                        <button class="btn-cancel-row" onclick="showCancelModal(<%= job.id %>, '<%= job.user.email %>')">Cancel</button>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="empty">
            <div class="empty-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6M9 12h6M9 15h4"/></svg></div>
            <div class="empty-title">No jobs found</div>
            <div class="empty-sub">Analysis jobs will appear here once submitted</div>
          </div>
        <% end %>
      </div>
    </div>

    <%# ── Active Jobs ──────────────────────────────────────── %>
    <div id="active" class="section">
      <div class="tcard">
        <div class="tcard-head">
          <span class="tcard-title">Active Jobs <span class="tcard-count">(<%= _active_jobs.count %>)</span></span>
          <button class="btn-clear" onclick="clearActive()">Clear view</button>
        </div>
        <% active_sorted = _active_jobs.sort_by(&:created_at).reverse %>
        <% if active_sorted.any? %>
          <div class="tscroll">
            <table id="active-table" class="dtable">
              <thead>
                <tr>
                  <th>Researcher</th>
                  <th>Job ID</th>
                  <th>Status</th>
                  <th>Submitted</th>
                  <th>Started</th>
                  <th>Queue #</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% active_sorted.each_with_index do |job, i| %>
                  <tr>
                    <td><span class="c-email"><%= job.user.email %></span></td>
                    <td><span class="c-id">#<%= job.id %></span></td>
                    <td><span class="pill <%= job.status == "Job submitted" ? "queued" : "running" %>"><%= job.status == "Job submitted" ? "Queued" : "Running" %></span></td>
                    <td><span class="c-time"><%= job.created_at.strftime("%b %d, %Y %H:%M") %></span></td>
                    <td><%= job.start_time.present? ? content_tag(:span, job.start_time.strftime("%b %d, %Y %H:%M"), class: "c-time") : content_tag(:span, "—", class: "c-nil") %></td>
                    <td><%= job.status == "Job submitted" ? content_tag(:span, i + 1, class: "q-rank") : content_tag(:span, "—", class: "c-nil") %></td>
                    <td>
                      <% if job.admin_can_manage_jobs?(current_admin) %>
                        <button class="btn-cancel-row" onclick="showCancelModal(<%= job.id %>, '<%= job.user.email %>')">Cancel</button>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="empty">
            <div class="empty-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></div>
            <div class="empty-title">No active jobs</div>
            <div class="empty-sub">The queue is clear — no jobs running or pending</div>
          </div>
        <% end %>
      </div>
    </div>

    <%# ── Completed ────────────────────────────────────────── %>
    <div id="completed" class="section">
      <div class="tcard">
        <div class="tcard-head">
          <span class="tcard-title">Completed Jobs <span class="tcard-count">(last 7 days · <%= _completed_jobs.count %>)</span></span>
          <button class="btn-clear" onclick="clearActive()">Clear view</button>
        </div>
        <% completed_sorted = _completed_jobs.sort_by(&:updated_at).reverse %>
        <% if completed_sorted.any? %>
          <div class="tscroll">
            <table id="completed-table" class="dtable">
              <thead>
                <tr>
                  <th>Researcher</th>
                  <th>Job ID</th>
                  <th>Submitted</th>
                  <th>Started</th>
                  <th>Ended</th>
                  <th>Duration</th>
                </tr>
              </thead>
              <tbody>
                <% completed_sorted.each do |job| %>
                  <tr>
                    <td><span class="c-email"><%= job.user.email %></span></td>
                    <td><span class="c-id">#<%= job.id %></span></td>
                    <td><span class="c-time"><%= job.created_at.strftime("%b %d, %Y %H:%M") %></span></td>
                    <td><%= job.start_time.present? ? content_tag(:span, job.start_time.strftime("%b %d, %Y %H:%M"), class: "c-time") : content_tag(:span, "—", class: "c-nil") %></td>
                    <td><%= job.end_time.present?   ? content_tag(:span, job.end_time.strftime("%b %d, %Y %H:%M"),   class: "c-time") : content_tag(:span, "—", class: "c-nil") %></td>
                    <td>
                      <% if job.start_time.present? && job.end_time.present? %>
                        <span class="c-dur"><%= ((job.end_time - job.start_time) / 60).round(1) %> min</span>
                      <% else %>
                        <span class="c-nil">—</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="empty">
            <div class="empty-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 6L9 17l-5-5"/></svg></div>
            <div class="empty-title">No completed jobs</div>
            <div class="empty-sub">No jobs completed in the last 7 days</div>
          </div>
        <% end %>
      </div>
    </div>

    <%# ── Failed ───────────────────────────────────────────── %>
    <div id="failed" class="section">
      <div class="tcard">
        <div class="tcard-head">
          <span class="tcard-title">Failed Jobs <span class="tcard-count">(last 7 days · <%= _failed_jobs.count %>)</span></span>
          <button class="btn-clear" onclick="clearActive()">Clear view</button>
        </div>
        <% failed_sorted = _failed_jobs.sort_by(&:updated_at).reverse %>
        <% if failed_sorted.any? %>
          <div class="tscroll">
            <table id="failed-table" class="dtable">
              <thead>
                <tr>
                  <th>Researcher</th>
                  <th>Job ID</th>
                  <th>Submitted</th>
                  <th>Started</th>
                  <th>Failed At</th>
                </tr>
              </thead>
              <tbody>
                <% failed_sorted.each do |job| %>
                  <tr>
                    <td><span class="c-email"><%= job.user.email %></span></td>
                    <td><span class="c-id">#<%= job.id %></span></td>
                    <td><span class="c-time"><%= job.created_at.strftime("%b %d, %Y %H:%M") %></span></td>
                    <td><%= job.start_time.present? ? content_tag(:span, job.start_time.strftime("%b %d, %Y %H:%M"), class: "c-time") : content_tag(:span, "—", class: "c-nil") %></td>
                    <td><%= job.end_time.present?   ? content_tag(:span, job.end_time.strftime("%b %d, %Y %H:%M"),   class: "c-time") : content_tag(:span, "—", class: "c-nil") %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="empty">
            <div class="empty-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M15 9l-6 6M9 9l6 6"/></svg></div>
            <div class="empty-title">No failed jobs</div>
            <div class="empty-sub">No jobs failed in the last 7 days</div>
          </div>
        <% end %>
      </div>
    </div>

    <%# ── Cancelled ────────────────────────────────────────── %>
    <div id="cancelled" class="section">
      <div class="tcard">
        <div class="tcard-head">
          <span class="tcard-title">Cancelled Jobs <span class="tcard-count">(last 7 days · <%= _cancelled_jobs.count %>)</span></span>
          <button class="btn-clear" onclick="clearActive()">Clear view</button>
        </div>
        <% cancelled_sorted = _cancelled_jobs.sort_by(&:updated_at).reverse %>
        <% if cancelled_sorted.any? %>
          <div class="tscroll">
            <table id="cancelled-table" class="dtable">
              <thead>
                <tr>
                  <th>Researcher</th>
                  <th>Job ID</th>
                  <th>Submitted</th>
                  <th>Cancelled At</th>
                </tr>
              </thead>
              <tbody>
                <% cancelled_sorted.each do |job| %>
                  <tr>
                    <td><span class="c-email"><%= job.user.email %></span></td>
                    <td><span class="c-id">#<%= job.id %></span></td>
                    <td><span class="c-time"><%= job.created_at.strftime("%b %d, %Y %H:%M") %></span></td>
                    <td><%= job.end_time.present? ? content_tag(:span, job.end_time.strftime("%b %d, %Y %H:%M"), class: "c-time") : content_tag(:span, "—", class: "c-nil") %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="empty">
            <div class="empty-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg></div>
            <div class="empty-title">No cancelled jobs</div>
            <div class="empty-sub">No jobs cancelled in the last 7 days</div>
          </div>
        <% end %>
      </div>
    </div>

    <%# ── Change username or password ─────────────────────────────────── %>
    <div class="settings-wrap">
      <button class="settings-toggle" id="stg-toggle">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"/></svg>
        Change username or password?
        <svg class="toggle-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="settings-body" id="stg-body">
        <div class="creds-grid">
          <div class="cred-card">
            <div class="cred-card-title">Change Username</div>
            <%= form_tag(update_admin_username_path, method: :patch) do %>
              <div class="form-field">
                <label class="form-lbl">Current Password</label>
                <%= password_field_tag :current_password, '', class: 'form-inp', placeholder: '••••••••' %>
              </div>
              <div class="form-field">
                <label class="form-lbl">New Username</label>
                <%= text_field_tag :new_username, '', class: 'form-inp', placeholder: 'Enter new username' %>
              </div>
              <%= submit_tag 'Update Username', class: 'btn-primary' %>
            <% end %>
            <% if flash.now[:error]&.include?('username') %>
              <div class="form-msg err"><%= flash.now[:error] %></div>
            <% end %>
            <% if flash.now[:success]&.include?('Username') %>
              <div class="form-msg ok"><%= flash.now[:success] %></div>
            <% end %>
          </div>
          <div class="cred-card">
            <div class="cred-card-title">Change Password</div>
            <%= form_tag(update_admin_password_path, method: :patch) do %>
              <div class="form-field">
                <label class="form-lbl">Current Password</label>
                <%= password_field_tag :current_password, '', class: 'form-inp', placeholder: '••••••••' %>
              </div>
              <div class="form-field">
                <label class="form-lbl">New Password</label>
                <%= password_field_tag :new_password, '', class: 'form-inp', placeholder: '••••••••' %>
              </div>
              <div class="form-field">
                <label class="form-lbl">Confirm New Password</label>
                <%= password_field_tag :password_confirmation, '', class: 'form-inp', placeholder: '••••••••' %>
              </div>
              <%= submit_tag 'Update Password', class: 'btn-primary' %>
            <% end %>
            <% if flash.now[:error]&.include?('password') %>
              <div class="form-msg err"><%= flash.now[:error] %></div>
            <% end %>
            <% if flash.now[:success]&.include?('Password') %>
              <div class="form-msg ok"><%= flash.now[:success] %></div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

  </div><%# /adm-content %>

  <%= render "layouts/footer" %>
</div><%# /adm-shell %>

<%# ── Cancel Modal ──────────────────────────────────────────── %>
<div id="cancelModal" class="modal-bg" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div class="modal-box">
    <div class="modal-hd">
      <div class="modal-ttl" id="modal-title">Cancel Job</div>
    </div>
    <div class="modal-bd">
      <p>You are about to cancel the following job. This action cannot be undone.</p>
      <div class="modal-row">
        <span class="modal-lbl">Job ID</span>
        <span class="modal-val" id="jobIdConfirm"></span>
      </div>
      <div class="modal-row">
        <span class="modal-lbl">Researcher</span>
        <span class="modal-val" id="userEmailConfirm"></span>
      </div>
      <div class="modal-warn">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;margin-top:1px"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        The researcher will receive an email notification when this job is cancelled.
      </div>
    </div>
    <div class="modal-ft">
      <button class="btn-keep" onclick="closeModal()">Keep Job</button>
      <button class="btn-confirm-cancel" id="confirmCancelBtn">Cancel Job</button>
    </div>
  </div>
</div>

<script>
  function clearActive() {
    const sec = document.querySelector('.section.active');
    if (sec) { const tb = sec.querySelector('tbody'); if (tb) tb.innerHTML = ''; }
  }

  function showCancelModal(jobId, userEmail) {
    document.getElementById('jobIdConfirm').innerText = '#' + jobId;
    document.getElementById('userEmailConfirm').innerText = userEmail;
    document.getElementById('confirmCancelBtn').onclick = function() { confirmCancel(jobId); };
    document.getElementById('cancelModal').classList.add('open');
  }

  function closeModal() {
    document.getElementById('cancelModal').classList.remove('open');
  }

  function confirmCancel(jobId) {
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = `/admin/jobs/${jobId}/cancel`;
    const mi = document.createElement('input'); mi.type = 'hidden'; mi.name = '_method'; mi.value = 'PATCH'; form.appendChild(mi);
    const ci = document.createElement('input'); ci.type = 'hidden'; ci.name = 'authenticity_token'; ci.value = document.querySelector('meta[name="csrf-token"]').getAttribute('content'); form.appendChild(ci);
    document.body.appendChild(form);
    form.submit();
  }

  document.addEventListener('DOMContentLoaded', function() {
    // Stat card navigation
    const cards    = document.querySelectorAll('.stat-card');
    const sections = document.querySelectorAll('.section');
    cards.forEach(card => {
      card.addEventListener('click', function() {
        cards.forEach(c => c.classList.remove('sel'));
        sections.forEach(s => s.classList.remove('active'));
        this.classList.add('sel');
        document.getElementById(this.dataset.filter).classList.add('active');
      });
    });

    // Settings accordion
    const stgToggle = document.getElementById('stg-toggle');
    const stgBody   = document.getElementById('stg-body');
    stgToggle.addEventListener('click', function() {
      const open = stgBody.classList.toggle('open');
      stgToggle.classList.toggle('open', open);
    });

    // Modal backdrop
    document.getElementById('cancelModal').addEventListener('click', function(e) {
      if (e.target === this) closeModal();
    });

    // Nav guard
    document.querySelectorAll('nav a, .home_link').forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        if (confirm('Please log out before navigating away from the admin page')) {
          if (this.href === 'https://genome.duke.edu/') window.open(this.href, '_blank');
        }
      });
    });
  });
</script>
</body>
</html>
