<h2>Currently Running Jobs</h2>
<ul>
  <% @jobs.each do |job| %>
    <li>
      <%= "#{job.id}: #{job.title}" %> <!-- Displaying the job number and title -->
      <% if Job.admin_can_manage_jobs?(current_admin) %> <!-- Updated the method call from Job to job -->
        <%= link_to 'Cancel', job, method: :delete, data: { confirm: 'Are you sure you want to cancel this job?' } %>
      <% end %>
    </li>
  <% end %>
</ul>
