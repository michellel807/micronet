<% content_for :title, "Admin Login" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "admin", "data-turbo-track": "reload" %>
<% end %>

<div class="adminscreen">
  <%= render "layouts/header" %>
  <main class="admin-login-main">
    <h1>Admin Login</h1>
    <%= form_tag authenticate_admin_path, method: :post, class: "admin-login-form" do %>
      <div class="login">
        <%= label_tag :username %>
        <%= text_field_tag :username, nil, autocomplete: "username" %>
      </div>
      <div class="login">
        <%= label_tag :password %>
        <%= password_field_tag :password, nil, autocomplete: "current-password" %>
      </div>
      <% if flash.now[:error] %>
        <div class="admin-error2"><%= flash.now[:error] %></div>
      <% end %>
      <%= submit_tag 'Login', class: "login-button" %>
    <% end %>
  </main>
  <%= render "layouts/footer" %>
</div>
