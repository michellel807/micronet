<!DOCTYPE html>
<html>
<head>
  <title>Parameter page</title>
  <%= stylesheet_link_tag 'parameter' %>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <style type="text/css">
    .checkbox-container {
      display: none;
    }
  </style>
  <script>
    $(document).ready(function() {
      $("input[name='pool_replicates']").on("change", function() {
        $(".checkbox-container").toggle(this.value === "yes");
      });
    });
  </script>
</head>
<body>
  <div class="homescreen">
    <header>
      <!-- Header content -->
    </header>

    <div class="column skinny">
      <% content_for :title, "Parameters page" %>

      <style>
        /* CSS styles */
      </style>

      <h1>Select Options</h1>

      <p>The Schmid Lab Growth Model can make use of several different optional parameters to optimize your results. Below, please select from these options before proceeding to the next page.</p>

      <div class="general-white-block">
        <form action="/selectanalyses" method="post">
          <h2>Pool Replicates?</h2>

          <div class="radio-container">
            <label class="option-label">
              <input type="radio" name="pool_replicates" value="no" checked>
              No
            </label>

            <label class="option-label">
              <input type="radio" name="pool_replicates" value="yes">
              Yes
            </label>
          </div>

          <div class="checkbox-container">
            <div id="checkbox-content">
              <h3 id="checkbox-header"></h3>
              <div class="additional-text">
                Please select the variable(s) to pool on. If selecting multiple variables, the Schmid Lab Growth Model will pool based on all unique combinations of the selected variables and model them jointly. For more information on this process, please <a href="http://firasmidani.github.io/amiga/doc/pooling.html">click here</a>.
              </div>
              <label>
                <input type="checkbox" name="pool_options[]" value="Plate_ID">
                Plate ID
              </label>
              <label>
                <input type="checkbox" id="isolate-checkbox" name="pool_options[]" value="Isolate">
                Isolate
              </label>
              <label>
                <input type="checkbox" id="pm-checkbox" name="pool_options[]" value="PM">
                PM
              </label>
              <label>
                <input type="checkbox" id="replicate-checkbox" name="pool_options[]" value="Replicate">
                Replicate
              </label>
              <label>
                <input type="checkbox" id="substrate-checkbox" name="pool_options[]" value="Substrate">
                Substrate
              </label>
              <label>
                <input type="checkbox" id="group-checkbox" name="pool_options[]" value="Group">
                Group
              </label>
              <label>
                <input type="checkbox" id="control-checkbox" name="pool_options[]" value="Control">
                Control
              </label>
            </div>
          </div>

          <input type="submit" value="Next" class="next-button">
        </form>
      </div>
    </div>
    <div class="footer"></div>
    <p>Copyright Schmid Lab 2023</p>
  </div>
  <div class="background-space"></div>
</body>
</html>
