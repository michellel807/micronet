<!DOCTYPE html>
<html>
<head>
  <title>Parameter page</title>
  <%= stylesheet_link_tag 'parameter' %>

  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script>
  $(document).ready(function() {
    $("input[name='pool_replicates']").on("change", function() {
      $(".checkbox-container").toggle(this.value === "yes");

      // Get the selected checkbox values
      var selectedOptions = [];
      $("input[name='pool_options[]']:checked").each(function() {
        selectedOptions.push($(this).val());
      });

      // Convert the array of selected values into a comma-separated string
      var selectedOptionsString = selectedOptions.join(",");

      // Store the selected options string in a hidden input field
      $("#selectedOptionsInput").val(selectedOptionsString);
    });

    // Get the "Next" button element
    var nextButton = $(".next-button");

    // Attach a click event handler to the "Next" button
    nextButton.on("click", function(e) {
      var poolReplicatesOption = $("input[name='pool_replicates']:checked").val();
      // If "Yes" is selected
      if (poolReplicatesOption === "yes") {
        // Get all the selected checkboxes
        var selectedCheckboxes = $("input[name='pool_options[]']:checked");
        // If no additional checkboxes are checked
        if (selectedCheckboxes.length === 0) {
          e.preventDefault(); // Prevent form submission
          alert("Please select at least one parameter or answer 'No'.");
        }
      }
    });
  });
  </script>
</head>


<body>
  <div class="homescreen">
    <header>
      <a href="https://genome.duke.edu/">
        <%= image_tag 'logo.png', alt: 'Duke Logo' %>
      </a>
      <h2 style="color:white;" href="/">THE SCHMID LAB MICROBIAL GROWTH MODEL</h2>
      <nav>
        <a class="wel_nav" href="/help">HELP</a>
        <a class="wel_nav" href="/resources">RESOURCES</a>
        <a class="wel_nav" href="/admin">ADMIN</a>
      </nav>
    </header>

    <div class="column skinny">
      <% content_for :title, "Parameters page" %>

      <style>
        .radio-container {
          display: flex;
          align-items: center;
          margin: auto;
        }

        .radio-container label {
          margin-right: 10px;
        }

        .checkbox-container {
          display: none;
        }
      </style>

      <h1>Select Options</h1>

      <p>The Schmid Lab Growth Model can make use of several different optional parameters to optimize your results. Below, please select from these options before proceeding to the next page.</p>

      <div class="general-white-block">
        <form id="parameter-form" action="/selectanalyses" method="post">
          <h2>Pool Replicates?</h2>

          <div class="radio-container">
            <label class="option-label">
              <input type="radio" name="pool_replicates" value="no" checked>
              No
            </label>

            <label class="option-label">
              <input type="radio" name="pool_replicates" value="yes">
              Yes
            </label>
          </div>

          <div class="checkbox-container">
            <div id="checkbox-content">
              <h3 id="checkbox-header"></h3>
              <div class="additional-text">
                Please select the variable(s) to pool on. If selecting multiple variables, the Schmid Lab Growth Model will pool based on all unique combinations of the selected variables and model them jointly. For more information on this process, please <a href="http://firasmidani.github.io/amiga/doc/pooling.html">click here</a>.
              </div>
              <label>
                <input type="checkbox" name="pool_options[]" value="Plate_ID">
                Plate ID
              </label>
              <label>
                <input type="checkbox" id="isolate-checkbox" name="pool_options[]" value="Isolate">
                Isolate
              </label>
              <label>
                <input type="checkbox" id="pm-checkbox" name="pool_options[]" value="PM">
                PM
              </label>
              <label>
                <input type="checkbox" id="replicate-checkbox" name="pool_options[]" value="Replicate">
                Replicate
              </label>
              <label>
                <input type="checkbox" id="substrate-checkbox" name="pool_options[]" value="Substrate">
                Substrate
              </label>
              <label>
                <input type="checkbox" id="group-checkbox" name="pool_options[]" value="Group">
                Group
              </label>
              <label>
                <input type="checkbox" id="control-checkbox" name="pool_options[]" value="Control">
                Control
              </label>
            </div>
          </div>

          <input type="hidden" name="selectedOptions" id="selectedOptionsInput">
          <input type="submit" value="Next" class="next-button">
        </form>
      </div>
    </div>
    <div class="footer"></div>
    <p> Copyright Schmid Lab 2023 </p>
  </div>
  <div class="background-space"></div>
</body>
</html>
