<div id="data-files-table-container">
  <% data_file_paths.each do |file_path| %>
    <% converted_file_path = convert_asc_to_tab_delimited(file_path) %>
    <% File.foreach(converted_file_path) do |line| %>
      <table class="fit-stats-table">
        <tr>
          <% line.split(",").each do |cell| %>
            <td><%= cell %></td>
          <% end %>
        </tr>
      </table>
    <% end %>
  <% end %>
</div>

<h3 id="mapping-files-header" style="text-align: center; margin-top: 10px; margin-bottom: 10px;">Your 
Mapping Files</h3>
<div id="mapping-files-table-container">
  <% mapping_file_paths.each do |file_path| %>
    <% File.foreach(file_path) do |line| %>
      <table class="fit-stats-table">
        <tr>
          <% line.split(",").each do |cell| %>
            <td><%= cell %></td>
          <% end %>
        </tr>
      </table>
    <% end %>
  <% end %>
</div>

