<div class = "uploadscreen">
  <%= render "layouts/header" %>

  <div class="column skinny">
  <%= render "layouts/stepper", current_step: 1 %>

<h1>MicroNet: Upload Files</h1>
<p>
  Valid formats: <code>.asc</code>, <code>.tsv</code>, <code>.txt</code>, <code>.csv</code>. <br>
  Go to <a href="/help" target="_blank"><strong>HELP</strong></a> to download the example files.
</p>

<p style="text-align: left;">
  If you are uploading data files with mapping files, upload them as explicit pairs below. Add another pair for each additional plate.
</p>

<% if @usr_data_file_names.present? || @usr_mapping_file_names.present? || @usr_meta_file_name.present? || @usr_interval_file_name.present? %>
  <div class="current-uploads" style="text-align: left; background: #f4f4f4; color: #333; padding: 12px 16px; border-radius: 6px; margin: 20px 0;">
    <strong>Currently uploaded.</strong> Submitting replaces <em>all</em> of these &mdash; re-select every file you want to keep, not just the ones you're changing:
    <ul style="margin: 8px 0 0; padding-left: 20px;">
      <% if @usr_data_file_names.present? %>
        <li>Data Files: <%= @usr_data_file_names.join(", ") %></li>
      <% end %>
      <% if @usr_mapping_file_names.present? %>
        <li>Mapping Files: <%= @usr_mapping_file_names.join(", ") %></li>
      <% end %>
      <% if @usr_meta_file_name.present? %>
        <li>Meta File: <%= @usr_meta_file_name %></li>
      <% end %>
      <% if @usr_interval_file_name.present? %>
        <li>Interval File: <%= @usr_interval_file_name %></li>
      <% end %>
      <li>GP Time Step Size: <%= @gp_time_step_size.presence || Job::DEFAULT_TSS %></li>
    </ul>
  </div>
<% end %>

<form id="upload-form" method="post" enctype="multipart/form-data" action="<%= upload_path %>">
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

  <div style="margin-top: 20px; text-align: left;">
    <h2>Data + Mapping Pairs</h2>
    <p style="text-align: left;">
      Each pair must include a data file. Mapping is optional per pair.
    </p>
    <div id="pair-rows"></div>
    <button type="button" id="add-pair-button" style="margin-top: 12px; padding: 10px 20px; background-color: #1a2456; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-weight: 600; font-size: 14px;">Add another pair</button>
  </div>

<p style="margin-top: 50px; text-align: left;">
  You can upload a meta file to provide plate-level information or to add additional details that complement your existing mapping files. <br>
  If you are only uploading a meta file, make sure your data file names correspond to the <strong style="font-weight: bold;">Plate_IDs</strong> shown in the preview window below, and leave the mapping file upload blank.
</p>

  <!-- Meta Files Upload -->
  <div style="margin-top: 10px;">
    <h2>Meta File</h2>
    <input type="file" id="meta-file-input" name="meta_files" accept=".txt,.tsv,.csv,.asc">
    <div id="meta-file-preview" hidden></div>
  </div>

  <% selected_tss_value = @gp_time_step_size.presence || Job::DEFAULT_TSS %>
  <% show_tss_options = selected_tss_value.to_s != Job::DEFAULT_TSS.to_s %>

  <div class="optional-upload-settings">
    <div>
      <h2>Interval File (Optional)</h2>
      <p>
        The default measurement interval is 600s. Upload an interval file only
        if your measurements use specific or non-default time intervals.
      </p>
      <input type="file" id="interval-file-input" name="interval_files" accept=".txt,.tsv,.csv,.asc">
    </div>

    <div>
      <h2>Data Thinning (Optional)</h2>
      <p>
        MicroNet uses a Gaussian Process time step size of
        <strong><span id="gp-time-step-size-current"><%= selected_tss_value %></span></strong>.
        The default value is <%= Job::DEFAULT_TSS %>, which keeps the full
        time-point resolution.
      </p>

      <div
        class="tss-control-shell"
        id="tss-control-shell"
        style="<%= show_tss_options ? 'display: none;' : '' %>"
      >
        <button
          type="button"
          id="show-tss-options"
          class="tss-toggle-button"
        >
          Change
        </button>
        <span class="tss-control-status">Default thinning setting</span>
      </div>

      <div id="gp-time-step-size-options" class="tss-options-panel" style="<%= show_tss_options ? '' : 'display: none;' %>">
        <label for="gp-time-step-size" class="field-label">
          Time step size
        </label>

        <input
          type="text"
          id="gp-time-step-size"
          name="gp_time_step_size"
          value="<%= selected_tss_value %>"
          inputmode="numeric"
          pattern="[1-9][0-9]*"
          autocomplete="off"
          required
          class="tss-number-input"
        >

        <p style="margin-top: 10px;">
          Larger values use fewer time points, which can reduce memory use but
          may affect interpretation of rapid growth dynamics. MicroNet will ask
          you to choose a lower value if it leaves fewer than
          <%= Job::MIN_GP_TIME_POINTS %> time points for fitting.
        </p>

        <p style="margin-top: 10px;">
          If the selected value still runs out of memory, MicroNet will retry up
          to three more times, increasing the time step size by 2 each time
          while keeping at least <%= Job::MIN_GP_TIME_POINTS %> time points for
          fitting.
        </p>
      </div>
    </div>
  </div>

  <input type="submit" value="Upload and Continue" class="upload-button">
</form>

<% if flash[:alert] %>
  <div class="error"><%= flash[:alert] %></div>
<% end %>

<% if flash.now[:error] %>
  <div class="error"><%= flash.now[:error] %></div>
<% end %>


<script>
document.getElementById('meta-file-input').addEventListener('change', function(event) {
  const file = event.target.files[0];
  const preview = document.getElementById('meta-file-preview');
  
  preview.hidden = !file;
  preview.textContent = ''; // Clear previous preview
  
  // Reset height to small default before loading new content
  preview.style.height = '50px';

  if (!file) return;

  const reader = new FileReader();

  reader.onload = function(e) {
    if (event.target.files[0] !== file) return;
    const lines = e.target.result.split('\n').slice(0, 50); // Show max 50 lines
    const firstColumnLines = lines.map(line => {
      const cells = line.includes('\t') ? line.split('\t') : line.split(',');
      return cells[0]?.trim();
    }).filter(cell => cell !== undefined && cell !== '');

    preview.textContent = firstColumnLines.join('\n');

    // Expand height based on content length, but max at 500px for example
    const lineCount = firstColumnLines.length;
    const lineHeightPx = 18; // Approximate line height in px (adjust if needed)
    let newHeight = lineCount * lineHeightPx + 20; // 20px for padding

    if (newHeight > 500) newHeight = 500;

    preview.style.height = newHeight + 'px';
  };

  reader.onerror = function() {
    if (event.target.files[0] !== file) return;
    preview.textContent = 'Error reading file.';
    preview.style.height = '50px'; // keep small on error
  };

  reader.readAsText(file);
});
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const pairRows = document.getElementById('pair-rows');
    const addPairButton = document.getElementById('add-pair-button');
    const form = document.getElementById('upload-form');
    const hasExistingUploads = <%= @usr_data_file_names.present? ? 'true' : 'false' %>;
    const gpTimeStepInput = document.getElementById('gp-time-step-size');
    const gpTimeStepPanel = document.getElementById('gp-time-step-size-options');
    const gpTimeStepButton = document.getElementById('show-tss-options');
    const gpTimeStepShell = document.getElementById('tss-control-shell');
    const gpTimeStepCurrent = document.getElementById('gp-time-step-size-current');
    let nextPairId = 1;

    function addFileRemoval(input, description) {
      const control = document.createElement('div');
      control.className = 'upload-file-control';
      input.parentNode.insertBefore(control, input);
      control.appendChild(input);
      input.setAttribute('aria-label', description);

      if (!input.id) input.id = `upload-${input.name.replace(/[^a-z0-9]/gi, '-')}`;

      const heading = document.createElement('span');
      heading.className = 'upload-file-label';
      heading.textContent = description;
      control.appendChild(heading);

      const preview = document.createElement('div');
      preview.className = 'upload-file-preview';
      const filename = document.createElement('label');
      filename.htmlFor = input.id;
      filename.className = 'upload-file-name';
      preview.appendChild(filename);

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'remove-file-button';
      button.textContent = '×';
      function updateSelection() {
        const file = input.files[0];
        control.classList.toggle('has-file', !!file);
        filename.textContent = file ? file.name : 'Choose file';
        filename.title = file ? file.name : `Choose ${description.toLowerCase()}`;
        button.hidden = !file;
        button.setAttribute('aria-label', file ? `Remove ${description.toLowerCase()}: ${file.name}` : `Remove ${description.toLowerCase()}`);
      }
      input.addEventListener('change', updateSelection);
      button.addEventListener('click', () => {
        input.value = '';
        input.dispatchEvent(new Event('change', { bubbles: true }));
        input.focus();
      });
      preview.appendChild(button);
      control.appendChild(preview);
      updateSelection();
    }

    addFileRemoval(document.getElementById('meta-file-input'), 'Meta file');
    addFileRemoval(document.getElementById('interval-file-input'), 'Interval file');

    function buildPairRow(index, pairId) {
      const wrapper = document.createElement('div');
      wrapper.className = 'pair-row';
      wrapper.dataset.pairId = String(pairId);

      const label = document.createElement('strong');
      label.textContent = `Pair ${index}`;
      label.className = 'pair-row-label';

      const header = document.createElement('div');
      header.className = 'pair-row-header';
      const removePairButton = document.createElement('button');
      removePairButton.type = 'button';
      removePairButton.className = 'remove-pair-button';
      removePairButton.textContent = 'Remove pair';
      removePairButton.setAttribute('aria-label', `Remove pair ${index}`);
      removePairButton.addEventListener('click', () => {
        wrapper.remove();
        if (pairRows.children.length === 0) addPairRow();
        pairRows.querySelectorAll('.pair-row').forEach((row, idx) => {
          row.querySelector('.pair-row-label').textContent = `Pair ${idx + 1}`;
          row.querySelector('.remove-pair-button').setAttribute('aria-label', `Remove pair ${idx + 1}`);
        });
        addPairButton.focus();
      });
      header.appendChild(label);
      header.appendChild(removePairButton);

      const dataInput = document.createElement('input');
      dataInput.type = 'file';
      dataInput.name = `data_pair_files[${pairId}]`;
      dataInput.accept = '.asc,.tsv,.txt,.csv';

      const mappingInput = document.createElement('input');
      mappingInput.type = 'file';
      mappingInput.name = `mapping_pair_files[${pairId}]`;
      mappingInput.accept = '.asc,.tsv,.txt,.csv';

      wrapper.appendChild(header);
      wrapper.appendChild(dataInput);
      wrapper.appendChild(mappingInput);
      addFileRemoval(dataInput, 'Data file');
      addFileRemoval(mappingInput, 'Mapping file');
      return wrapper;
    }

    function addPairRow() {
      const index = pairRows.querySelectorAll('.pair-row').length + 1;
      const pairId = nextPairId;
      nextPairId += 1;
      pairRows.appendChild(buildPairRow(index, pairId));
    }

    addPairButton.addEventListener('click', addPairRow);
    addPairRow();

    if (gpTimeStepButton && gpTimeStepPanel) {
      gpTimeStepButton.addEventListener('click', () => {
        gpTimeStepPanel.style.display = 'block';
        if (gpTimeStepShell) {
          gpTimeStepShell.style.display = 'none';
        }
        if (gpTimeStepInput) {
          gpTimeStepInput.focus();
        }
      });
    }

    if (gpTimeStepInput) {
      gpTimeStepInput.addEventListener('input', () => {
        gpTimeStepInput.value = gpTimeStepInput.value.replace(/\D/g, '').replace(/^0+/, '');
        if (gpTimeStepCurrent) {
          gpTimeStepCurrent.textContent = gpTimeStepInput.value || '<%= Job::DEFAULT_TSS %>';
        }
      });

      gpTimeStepInput.addEventListener('blur', () => {
        if (gpTimeStepInput.value === '') {
          gpTimeStepInput.value = '<%= Job::DEFAULT_TSS %>';
        }
        if (gpTimeStepCurrent) {
          gpTimeStepCurrent.textContent = gpTimeStepInput.value;
        }
      });
    }

    form.addEventListener('submit', (event) => {
      const rows = pairRows.querySelectorAll('.pair-row');
      for (const row of rows) {
        const dataInput = row.querySelector('input[type="file"][name^="data_pair_files["]');
        const mappingInput = row.querySelector('input[type="file"][name^="mapping_pair_files["]');
        const hasData = dataInput && dataInput.files.length > 0;
        const hasMapping = mappingInput && mappingInput.files.length > 0;

        if (!hasData && hasMapping) {
          event.preventDefault();
          alert('Each pair row with a mapping file must also include a data file.');
          return;
        }
      }

      const hasDataUpload = Array.from(rows).some(row => {
        const dataInput = row.querySelector('input[type="file"][name^="data_pair_files["]');
        return dataInput && dataInput.files.length > 0;
      });

      if (!hasDataUpload && !hasExistingUploads) {
        event.preventDefault();
        alert('Please upload at least one data file.');
      }
    });
  });
</script>

<div class="background-space"></div>

</div>
  <%= render "layouts/footer" %>
</div>
