<div class = "uploadscreen">
  <%= render "layouts/header" %>

  <div class="column skinny">
  <%= render "layouts/stepper", current_step: 1 %>

<h1>MicroNet: Upload Files</h1>
<p>
  Valid formats: <code>.asc</code>, <code>.tsv</code>, <code>.txt</code>, <code>.csv</code>. <br>
  Go to <a href="/help" target="_blank"><strong>HELP</strong></a> to download the example files.
</p>

<p style="text-align: left;">
  If you are uploading data files with mapping files, upload them as explicit pairs below. Add another pair for each additional plate.
</p>

<% if @usr_data_file_names.present? || @usr_mapping_file_names.present? || @usr_meta_file_name.present? || @usr_interval_file_name.present? %>
  <div class="current-uploads" style="text-align: left; background: #f4f4f4; color: #333; padding: 12px 16px; border-radius: 6px; margin: 20px 0;">
    <strong>Currently uploaded.</strong> Submitting replaces <em>all</em> of these &mdash; re-select every file you want to keep, not just the ones you're changing:
    <ul style="margin: 8px 0 0; padding-left: 20px;">
      <% if @usr_data_file_names.present? %>
        <li>Data Files: <%= @usr_data_file_names.join(", ") %></li>
      <% end %>
      <% if @usr_mapping_file_names.present? %>
        <li>Mapping Files: <%= @usr_mapping_file_names.join(", ") %></li>
      <% end %>
      <% if @usr_meta_file_name.present? %>
        <li>Meta File: <%= @usr_meta_file_name %></li>
      <% end %>
      <% if @usr_interval_file_name.present? %>
        <li>Interval File: <%= @usr_interval_file_name %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<form id="upload-form" method="post" enctype="multipart/form-data" action="<%= upload_path %>">
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

  <div style="margin-top: 20px; text-align: left;">
    <h2>Data + Mapping Pairs</h2>
    <p style="text-align: left;">
      Each pair must include a data file. Mapping is optional per pair.
    </p>
    <div id="pair-rows"></div>
    <button type="button" id="add-pair-button" style="margin-top: 12px; padding: 10px 20px; background-color: #1a2456; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-weight: 600; font-size: 14px;">Add another pair</button>
  </div>

<p style="margin-top: 50px; text-align: left;">
  You can upload a meta file to provide plate-level information or to add additional details that complement your existing mapping files. <br>
  If you are only uploading a meta file, make sure your data file names correspond to the <strong style="font-weight: bold;">Plate_IDs</strong> shown in the preview window below, and leave the mapping file upload blank.
</p>

  <!-- Meta Files Upload -->
  <div style="margin-top: 10px;">
    <h2>Meta File</h2>
    <div id="meta-file-preview"
     style="margin: 20px auto;
            background: #f4f4f4;
            color: #333;
            padding: 10px;
            white-space: pre-wrap;
            border-radius: 6px;
            height: 50px;
            width: 300px;
            overflow-y: auto;
            font-family: monospace;
            text-align: left;">
      </div>
    <input type="file" id="meta-file-input" name="meta_files" accept=".txt,.tsv,.csv,.asc">
  </div>

<p style="font-weight: 500; margin-top: 50px; text-align: left;">
  The default measurement interval is set to 600s. If you want to specify specific time intervals, please upload the interval file below.
</p>

    <!-- Interval Files Upload -->
  <div style="margin-top: 30px;">
    <h2>Interval File (Optional)</h2>
    <input type="file" id="interval-file-input" name="interval_files" accept=".txt,.tsv,.csv,.asc">
  </div>

  <input type="submit" value="Upload and Continue" class="upload-button">
</form>

<% if flash.now[:alert] %>
  <div class="error"><%= flash.now[:alert] %></div>
<% end %>

<% if flash.now[:error] %>
  <div class="error"><%= flash.now[:error] %></div>
<% end %>


<script>
document.getElementById('meta-file-input').addEventListener('change', function(event) {
  const file = event.target.files[0];
  const preview = document.getElementById('meta-file-preview');
  
  preview.textContent = ''; // Clear previous preview
  
  // Reset height to small default before loading new content
  preview.style.height = '50px';

  if (!file) return;

  const reader = new FileReader();

  reader.onload = function(e) {
    const lines = e.target.result.split('\n').slice(0, 50); // Show max 50 lines
    const firstColumnLines = lines.map(line => {
      const cells = line.includes('\t') ? line.split('\t') : line.split(',');
      return cells[0]?.trim();
    }).filter(cell => cell !== undefined && cell !== '');

    preview.textContent = firstColumnLines.join('\n');

    // Expand height based on content length, but max at 500px for example
    const lineCount = firstColumnLines.length;
    const lineHeightPx = 18; // Approximate line height in px (adjust if needed)
    let newHeight = lineCount * lineHeightPx + 20; // 20px for padding

    if (newHeight > 500) newHeight = 500;

    preview.style.height = newHeight + 'px';
  };

  reader.onerror = function() {
    preview.textContent = 'Error reading file.';
    preview.style.height = '50px'; // keep small on error
  };

  reader.readAsText(file);
});
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const pairRows = document.getElementById('pair-rows');
    const addPairButton = document.getElementById('add-pair-button');
    const form = document.getElementById('upload-form');
    let nextPairId = 1;

    function buildPairRow(index, pairId) {
      const wrapper = document.createElement('div');
      wrapper.className = 'pair-row';
      wrapper.style.display = 'flex';
      wrapper.style.gap = '12px';
      wrapper.style.alignItems = 'center';
      wrapper.style.marginBottom = '10px';
      wrapper.dataset.pairId = String(pairId);

      const label = document.createElement('strong');
      label.textContent = `Pair ${index}`;
      label.style.minWidth = '60px';

      const dataInput = document.createElement('input');
      dataInput.type = 'file';
      dataInput.name = `data_pair_files[${pairId}]`;
      dataInput.accept = '.asc,.tsv,.txt,.csv';

      const mappingInput = document.createElement('input');
      mappingInput.type = 'file';
      mappingInput.name = `mapping_pair_files[${pairId}]`;
      mappingInput.accept = '.asc,.tsv,.txt,.csv';

      const removeButton = document.createElement('button');
      removeButton.type = 'button';
      removeButton.textContent = 'Remove';
      removeButton.style.padding = '10px 20px';
      removeButton.style.backgroundColor = '#fff';
      removeButton.style.color = '#c0392b';
      removeButton.style.border = '1px solid #c0392b';
      removeButton.style.borderRadius = '4px';
      removeButton.style.cursor = 'pointer';
      removeButton.style.fontWeight = '600';
      removeButton.style.fontSize = '14px';
      removeButton.addEventListener('click', () => {
        wrapper.remove();
        renumberPairs();
      });

      wrapper.appendChild(label);
      wrapper.appendChild(dataInput);
      wrapper.appendChild(mappingInput);
      wrapper.appendChild(removeButton);
      return wrapper;
    }

    function renumberPairs() {
      const rows = pairRows.querySelectorAll('.pair-row');
      rows.forEach((row, idx) => {
        const label = row.querySelector('strong');
        if (label) label.textContent = `Pair ${idx + 1}`;
      });
    }

    function addPairRow() {
      const index = pairRows.querySelectorAll('.pair-row').length + 1;
      const pairId = nextPairId;
      nextPairId += 1;
      pairRows.appendChild(buildPairRow(index, pairId));
    }

    addPairButton.addEventListener('click', addPairRow);
    addPairRow();

    form.addEventListener('submit', (event) => {
      const rows = pairRows.querySelectorAll('.pair-row');
      for (const row of rows) {
        const dataInput = row.querySelector('input[type="file"][name^="data_pair_files["]');
        const mappingInput = row.querySelector('input[type="file"][name^="mapping_pair_files["]');
        const hasData = dataInput && dataInput.files.length > 0;
        const hasMapping = mappingInput && mappingInput.files.length > 0;

        if (!hasData && hasMapping) {
          event.preventDefault();
          alert('Each pair row with a mapping file must also include a data file.');
          return;
        }
      }

      const hasDataUpload = Array.from(rows).some(row => {
        const dataInput = row.querySelector('input[type="file"][name^="data_pair_files["]');
        return dataInput && dataInput.files.length > 0;
      });

      if (!hasDataUpload) {
        event.preventDefault();
        alert('Please upload at least one data file.');
      }
    });
  });
</script>

<div class="background-space"></div>

</div>
  <%= render "layouts/footer" %>
</div>
