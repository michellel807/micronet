<div class = "upload">
  <!DOCTYPE html>
<html>
  <head>
    <title>Upload page</title>
    <%= stylesheet_link_tag 'upload' %>
  <head>
  <body>
    <%= yield %>
    <script>
    document.addEventListener("DOMContentLoaded", function() {
      var container = document.getElementById("data-files-container");
      var header = document.getElementById("data-files-header");
      var button = document.getElementById("view-files-button");
      var tableContainer = document.getElementById("data-files-table-container");
  
      button.style.display = "none"; // Hide the button initially
  
      button.addEventListener("click", function() {
        if (container.style.display === "none") {
          container.style.display = "block";
          header.style.display = "block";
        } else {
          container.style.display = "none";
          header.style.display = "none";
        }
      });
  
      // Show the button after the notice is displayed
      var notice = document.querySelector(".notice");
      if (notice) {
        button.style.display = "block";
      }

    });
  </script>
  </body>
</html>

<div class = "uploadscreen">
  <%= render "layouts/header" %>

  <div class="column skinny">
  <div class="stepper-wrapper">
  <div class="stepper-item active">
    <a href="<%= upload_path %>" style="text-decoration: none; color: #000750"> 
      <div class="step-counter">1</div>
      <div class="step-name">Upload Files</div>
    </a>
  </div>
  <div class="stepper-item">
      <div class="step-counter">2</div>
    </a>
    <div class="step-name">Select Analyses</div>
  </div>
  <div class="stepper-item">
    <div class="step-counter">3</div>
    <div class="step-name">Review</div>
  </div>
  <div class="stepper-item">
    <div class="step-counter">4</div>
    <div class="step-name">Submit</div>
  </div>
</div>

    <h1>MicroNet: Upload Files</h1>
       <p>The model takes plate reader data as an input data file and a metadata/mapping file containing the metadata 
associated with each well. Valid file formats are .asc, .tsv, .txt, or .csv. Please <a href="https://firasmidani.github.io/amiga/doc/metadata.html" target="_blank">click here</a> to learn more about the mandatory formatting 
of the metadata file. Please note that the application will convert the input files to .csv for the analysis</p>
  </div>

  <div class="general-white-block">
  <h2>Upload Data and Metadata File(s)</h2>
  <%= form_tag(upload_path, multipart: true) do %>
    <p>
      <label for="data_files">Data File:</label>
      <%= file_field_tag 'data_files[]', multiple: true %>
    </p>
    <p>
      <label for="mapping_files">Mapping File:</label>
      <%= file_field_tag 'mapping_files[]', multiple: true %>
    </p>
    <%= submit_tag 'Upload', class: 'upload-button' %>
  <% end %>

  <% if flash.now[:alert] %>
  <div class="error">
    <%= flash.now[:alert] %>
  </div>
<% end %>

<% if flash.now[:error] %>
<div class="error">
  <%= flash.now[:error] %>
</div>
<% end %>

  <% if @data_file_paths.present? && @mapping_file_paths.present? %>
  <div class="notice">
    <p>
      <span class="success" style="color: black; font-weight: 500;">Files uploaded successfully. </span>
    </p>
    <div class="upload-notice" style="color: blue; font-weight: 300;">
      <p>
        <span class="current">Currently uploaded data file(s): <%= @data_file_names %></span>
      </p>
      <p>
        <span class="current">Currently uploaded mapping file(s): <%= @mapping_file_names %></span>
      </p>
    </div>
  </div>
<% end %>

  <button id="view-files-button" style="margin-top: 20px; margin-bottom: 40px;">View Files</button>
  <div id="data-files-container" style="display: none;">
  <h3 id="data-files-header" style="text-align: center; margin-top: 10px; margin-bottom: 10px;">Your Data Files</h3>
    <div id="data-files-table-container">
    <% if @data_file_paths.present? %>
      <% @data_file_paths.each do |file_path| %>
        <% next unless File.exist?(file_path) %>
        <% File.foreach(file_path) do |line| %>
          <table class="fit-stats-table">
            <tr>
              <% line.split(",").each do |cell| %>
                <td><%= cell %></td>
              <% end %>
            </tr>
          </table>
        <% end %>
      <% end %>
    <%else%>
      <p> No data files to display. </p>
    <% end %>
    </div>
    
    <h3 id="mapping-files-header" style="text-align: center; margin-top: 10px; margin-bottom: 10px;">Your Mapping Files</h3>
    <div id="mapping-files-table-container">
      <% if @mapping_file_paths.present? && File.exist?(@mapping_file_paths[0]) %>
        <% File.foreach(@mapping_file_paths[0]) do |line| %>
            <table class="fit-stats-table">
              <tr>
                <% line.split(",").each do |cell| %>
                  <td><%= cell %></td>
                <% end %>
              </tr>
            </table>
        <% end %>
      <%else%>
        <p> No mapping files to display. </p>
      <%end%>
    </div>
    </div>

  <% if @data_file_paths.present? && @mapping_file_paths.present? && File.exist?(@mapping_file_paths[0]) %>
  <%= link_to "Next", 'selectanalyses', class: "next-button" %>
  <% end %>
<div class="background-space"></div>

</div>
  <%= render "layouts/footer" %>
</div>
