<div class = "upload">
  <!DOCTYPE html>
<html>
  <head>
    <title>Upload page</title>
    <%= stylesheet_link_tag 'upload' %>
  <head>
  <body>
    <%= yield %>
    <script>
    document.addEventListener("DOMContentLoaded", function() {
      var container = document.getElementById("data-files-container");
      var header = document.getElementById("data-files-header");
      var button = document.getElementById("view-files-button");
      var tableContainer = document.getElementById("data-files-table-container");

      if (!container || !header || !button || !tableContainer) {
        return;
      }
  
      button.style.display = "none"; // Hide the button initially
  
      button.addEventListener("click", function() {
        if (container.style.display === "none") {
          container.style.display = "block";
          header.style.display = "block";
        } else {
          container.style.display = "none";
          header.style.display = "none";
        }
      });
  
      // Show the button after the notice is displayed
      var notice = document.querySelector(".notice");
      if (notice) {
        button.style.display = "block";
      }

    });
  </script>
  </body>
</html>

<div class = "uploadscreen">
  <%= render "layouts/header" %>

  <div class="column skinny">
  <%= render "layouts/stepper", current_step: 1 %>

<h1>MicroNet: Upload Files</h1>
<p>
  Valid formats: <code>.asc</code>, <code>.tsv</code>, <code>.txt</code>, <code>.csv</code>. <br>
  Go to <a href="/help" target="_blank"><strong>HELP</strong></a> to download the example files.
</p>

<p style="text-align: left;">
  If you are uploading data files with mapping files, please drag and arrange them to match each data file with its corresponding mapping file.
</p>

<form id="upload-form" method="post" enctype="multipart/form-data" action="<%= upload_path %>">
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
  <input type="hidden" name="ordered_data_files" id="ordered_data_files">
  <input type="hidden" name="ordered_mapping_files" id="ordered_mapping_files">

  <div style="display: flex; gap: 40px; justify-content: center; margin-top: 10px;">
    <!-- Data Files Column -->
    <div>
      <h2>Data Files</h2>
      <ul id="data-files-list" class="sortable-list"></ul>
      <input type="file" id="data-file-input" multiple name="data_files[]">
    </div>

    <!-- Mapping Files Column -->
    <div>
      <h2>Mapping Files</h2>
      <ul id="mapping-files-list" class="sortable-list"></ul>
      <input type="file" id="mapping-file-input" multiple name="mapping_files[]">
    </div>
  </div>

<p style="margin-top: 50px; text-align: left;">
  You can upload a meta file to provide plate-level information or to add additional details that complement your existing mapping files. <br>
  If you are only uploading a meta file, please arrange your data files to match the order of <strong style="font-weight: bold;">Plate_IDs</strong> shown in the preview window below, and leave the mapping file upload blank.
</p>

  <!-- Meta Files Upload -->
  <div style="margin-top: 10px;">
    <h2>Meta File</h2>
    <div id="meta-file-preview"
     style="margin: 20px auto;
            background: #f4f4f4;
            color: #333;
            padding: 10px;
            white-space: pre-wrap;
            border-radius: 6px;
            height: 50px;
            width: 300px;
            overflow-y: auto;
            font-family: monospace;
            text-align: left;">
      </div>
    <input type="file" id="meta-file-input" name="meta_files" accept=".txt,.tsv,.csv,.asc">
  </div>

<p style="font-weight: 500; color: white; margin-top: 50px; text-align: left;">
  The default measurement interval is set to 600s. If you want to specify specific time intervals, please upload the interval file below. 
</p>

    <!-- Interval Files Upload -->
  <div style="margin-top: 30px;">
    <h2>Interval File (Optional)</h2>
    <input type="file" id="interval-file-input" name="interval_files" accept=".txt,.tsv,.csv,.asc">
  </div>

  <input type="submit" value="Upload and Continue" class="upload-button">
</form>

<% if flash.now[:alert] %>
  <div class="error"><%= flash.now[:alert] %></div>
<% end %>

<% if flash.now[:error] %>
  <div class="error"><%= flash.now[:error] %></div>
<% end %>


  <% if (@data_file_paths.present? &&
      (@mapping_file_paths.present? || @meta_file_path.present?)) %>
  <script>
    // Redirect immediately to analysis selection
    window.location.href = '<%= selectanalyses_path %>';
  </script>
<% end %>

<script>
document.getElementById('meta-file-input').addEventListener('change', function(event) {
  const file = event.target.files[0];
  const preview = document.getElementById('meta-file-preview');
  
  preview.textContent = ''; // Clear previous preview
  
  // Reset height to small default before loading new content
  preview.style.height = '50px';

  if (!file) return;

  const reader = new FileReader();

  reader.onload = function(e) {
    const lines = e.target.result.split('\n').slice(0, 50); // Show max 50 lines
    const firstColumnLines = lines.map(line => {
      const cells = line.includes('\t') ? line.split('\t') : line.split(',');
      return cells[0]?.trim();
    }).filter(cell => cell !== undefined && cell !== '');

    preview.textContent = firstColumnLines.join('\n');

    // Expand height based on content length, but max at 500px for example
    const lineCount = firstColumnLines.length;
    const lineHeightPx = 18; // Approximate line height in px (adjust if needed)
    let newHeight = lineCount * lineHeightPx + 20; // 20px for padding

    if (newHeight > 500) newHeight = 500;

    preview.style.height = newHeight + 'px';
  };

  reader.onerror = function() {
    preview.textContent = 'Error reading file.';
    preview.style.height = '50px'; // keep small on error
  };

  reader.readAsText(file);
});
</script>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (window.Sortable) {
      new Sortable(document.getElementById('data-files-list'), { animation: 150 });
      new Sortable(document.getElementById('mapping-files-list'), { animation: 150 });
    }

    function handleFileInput(inputId, listId) {
      const input = document.getElementById(inputId);
      const list = document.getElementById(listId);
      let selectedFiles = [];

      function syncInputFiles() {
        const dataTransfer = new DataTransfer();
        selectedFiles.forEach(file => dataTransfer.items.add(file));
        input.files = dataTransfer.files;
      }

      function renderFileList() {
        list.innerHTML = '';
        selectedFiles.forEach(file => {
          const li = document.createElement('li');
          li.className = 'sortable-item';
          li.style.display = 'flex';
          li.style.justifyContent = 'space-between';
          li.style.alignItems = 'center';
          const nameSpan = document.createElement('span');
          nameSpan.innerText = file.name;

          const removeButton = document.createElement('button');
          removeButton.type = 'button';
          removeButton.innerText = 'x';
          removeButton.setAttribute('aria-label', `Remove ${file.name}`);
          removeButton.style.background = 'none';
          removeButton.style.border = 'none';
          removeButton.style.color = '#ff6b6b';
          removeButton.style.cursor = 'pointer';
          removeButton.style.fontSize = '18px';
          removeButton.style.marginLeft = '10px';

          removeButton.addEventListener('click', () => {
            selectedFiles = selectedFiles.filter(selectedFile => selectedFile.name !== file.name);
            syncInputFiles();
            renderFileList();
          });

          li.appendChild(nameSpan);
          li.appendChild(removeButton);
          list.appendChild(li);
        });
      }

      input.addEventListener('change', () => {
        Array.from(input.files).forEach(file => {
          if (!selectedFiles.some(selectedFile => selectedFile.name === file.name)) {
            selectedFiles.push(file);
          }
        });
        syncInputFiles();
        renderFileList();
      });
    }

    handleFileInput('data-file-input', 'data-files-list');
    handleFileInput('mapping-file-input', 'mapping-files-list');

    // On form submission, capture file order
    const form = document.getElementById('upload-form');
    form.addEventListener('submit', (e) => {
      const dataList = Array.from(document.querySelectorAll('#data-files-list .sortable-item')).map(el => el.querySelector('span').innerText);
      const mappingList = Array.from(document.querySelectorAll('#mapping-files-list .sortable-item')).map(el => el.querySelector('span').innerText);

      document.getElementById('ordered_data_files').value = JSON.stringify(dataList);
      document.getElementById('ordered_mapping_files').value = JSON.stringify(mappingList);
    });
  });
</script>

<div class="background-space"></div>

</div>
  <%= render "layouts/footer" %>
</div>
