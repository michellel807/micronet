<div class = "uploadscreen">
  <%= render "layouts/header" %>

  <div class="column skinny">
  <%= render "layouts/stepper", current_step: 1 %>

<h1>MicroNet: Upload Files</h1>
<p>
  Valid formats: <code>.asc</code>, <code>.tsv</code>, <code>.txt</code>, <code>.csv</code>. <br>
  Go to <a href="/help" target="_blank"><strong>HELP</strong></a> to download the example files.
</p>

<p style="text-align: left;">
  Upload each data file with its matching mapping file below. Add another pair for each additional plate.
</p>

<form id="upload-form" method="post" enctype="multipart/form-data" action="<%= upload_path %>">
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

  <div style="margin-top: 20px; text-align: left;">
    <h2>Data + Mapping Pairs</h2>
    <p style="text-align: left;">
      Each pair must include both a data file and a mapping file.
    </p>
    <div id="pair-rows"></div>
    <button type="button" id="add-pair-button" style="margin-top: 12px; padding: 10px 20px; background-color: #1a2456; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-weight: 600; font-size: 14px;">Add another pair</button>
  </div>

  <!-- Meta Files Upload -->
  <div style="margin-top: 40px;">
    <h2>Meta File (Optional)</h2>
    <p>
      Upload a meta file alongside your data files to add information that applies
      to an entire plate, such as its strain or growth medium.
    </p>
    <ul>
      <li>Use the same <code>Plate_ID</code> values as in those files.</li>
    </ul>
    <p>After you select a meta file, the preview below shows its <code>Plate_ID</code> values.</p>
    <input type="file" id="meta-file-input" name="meta_files" accept=".txt,.tsv,.csv,.asc">
    <div id="meta-file-preview" hidden></div>
  </div>

  <% selected_tss_value = @gp_time_step_size.presence || Job::DEFAULT_TSS %>

  <div class="optional-upload-settings">
    <div class="optional-upload-setting">
      <h2>Interval File (Optional)</h2>
      <p>
        The default measurement interval is 600s. Upload an interval file only
        if your measurements use specific or non-default time intervals.
      </p>
      <input type="file" id="interval-file-input" name="interval_files" accept=".txt,.tsv,.csv,.asc">
    </div>

    <div class="optional-upload-setting">
      <h2><label for="gp-time-step-size">Time step size (Optional)</label></h2>
      <p id="gp-time-step-size-description">
        Use every nth time point for Gaussian Process fitting.
        The default, <%= Job::DEFAULT_TSS %>, keeps every measurement.
      </p>
      <input
        type="text"
        id="gp-time-step-size"
        name="gp_time_step_size"
        value="<%= selected_tss_value %>"
        inputmode="numeric"
        pattern="[1-9][0-9]*"
        autocomplete="off"
        required
        aria-describedby="gp-time-step-size-description gp-time-step-size-help"
        class="tss-number-input"
      >
    </div>
    <div class="tss-help">
      <p id="gp-time-step-size-help">
        Larger time step sizes reduce memory use but may miss rapid changes.
        Keep at least <%= Job::MIN_GP_TIME_POINTS %> time points for fitting.
      </p>
      <details>
        <summary>Minimum data and automatic retries</summary>
        <p>
          MicroNet will ask you to choose a lower value if your selection leaves
          fewer than <%= Job::MIN_GP_TIME_POINTS %> time points for fitting.
          If fitting runs out of memory, MicroNet retries up to
          <%= Job::MAX_TSS_ATTEMPTS - 1 %> more times, increasing the time step
          size by <%= Job::TSS_RETRY_INCREMENT %> each time while keeping at least
          <%= Job::MIN_GP_TIME_POINTS %> time points.
        </p>
      </details>
    </div>
  </div>

  <input type="submit" value="Upload and Continue" class="upload-button">
</form>

<% if flash[:alert] %>
  <div class="error"><%= flash[:alert] %></div>
<% end %>

<% if flash.now[:error] %>
  <div class="error"><%= flash.now[:error] %></div>
<% end %>


<script>
document.getElementById('meta-file-input').addEventListener('change', function(event) {
  const file = event.target.files[0];
  const preview = document.getElementById('meta-file-preview');
  
  preview.hidden = !file;
  preview.textContent = ''; // Clear previous preview
  
  // Reset height to small default before loading new content
  preview.style.height = '50px';

  if (!file) return;

  const reader = new FileReader();

  reader.onload = function(e) {
    if (event.target.files[0] !== file) return;
    const lines = e.target.result.split('\n').slice(0, 50); // Show max 50 lines
    const firstColumnLines = lines.map(line => {
      const cells = line.includes('\t') ? line.split('\t') : line.split(',');
      return cells[0]?.trim();
    }).filter(cell => cell !== undefined && cell !== '');

    preview.textContent = firstColumnLines.join('\n');

    // Expand height based on content length, but max at 500px for example
    const lineCount = firstColumnLines.length;
    const lineHeightPx = 18; // Approximate line height in px (adjust if needed)
    let newHeight = lineCount * lineHeightPx + 20; // 20px for padding

    if (newHeight > 500) newHeight = 500;

    preview.style.height = newHeight + 'px';
  };

  reader.onerror = function() {
    if (event.target.files[0] !== file) return;
    preview.textContent = 'Error reading file.';
    preview.style.height = '50px'; // keep small on error
  };

  reader.readAsText(file);
});
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const pairRows = document.getElementById('pair-rows');
    const addPairButton = document.getElementById('add-pair-button');
    const form = document.getElementById('upload-form');
    const savedPairs = <%= raw(json_escape(saved_upload_pairs(@job).map { |pair| pair.slice(:id, :data_name, :mapping_name) }.to_json)) %>;
    const gpTimeStepInput = document.getElementById('gp-time-step-size');
    let nextPairId = 1;

    function addFileRemoval(input, description, savedName = null, removalName = null) {
      const control = document.createElement('div');
      control.className = 'upload-file-control';
      input.parentNode.insertBefore(control, input);
      control.appendChild(input);
      input.setAttribute('aria-label', description);

      if (!input.id) input.id = `upload-${input.name.replace(/[^a-z0-9]/gi, '-')}`;

      const removed = document.createElement('input');
      removed.type = 'hidden';
      removed.name = removalName || 'unused_removal';
      removed.value = '1';
      removed.disabled = true;
      control.appendChild(removed);
      input.dataset.savedName = savedName || '';

      const heading = document.createElement('span');
      heading.className = 'upload-file-label';
      heading.textContent = description;
      control.appendChild(heading);

      const preview = document.createElement('div');
      preview.className = 'upload-file-preview';
      const filename = document.createElement('label');
      filename.htmlFor = input.id;
      filename.className = 'upload-file-name';
      preview.appendChild(filename);

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'remove-file-button';
      button.textContent = '×';
      function updateSelection() {
        const file = input.files[0];
        const name = file ? file.name : input.dataset.savedName;
        control.classList.toggle('has-file', !!name);
        filename.textContent = name || 'Choose file';
        filename.title = name || `Choose ${description.toLowerCase()}`;
        button.hidden = !name;
        button.setAttribute('aria-label', `Remove ${description.toLowerCase()}${name ? ': ' + name : ''}`);
      }
      input.addEventListener('change', updateSelection);
      button.addEventListener('click', () => {
        input.value = '';
        input.dataset.savedName = '';
        removed.disabled = false;
        input.dispatchEvent(new Event('change', { bubbles: true }));
        input.focus();
      });
      preview.appendChild(button);
      control.appendChild(preview);
      updateSelection();
    }

    addFileRemoval(document.getElementById('meta-file-input'), 'Meta file', <%= raw(json_escape(session[:usr_meta_file_path].to_json)) %>, 'remove_meta_file');
    addFileRemoval(document.getElementById('interval-file-input'), 'Interval file', <%= raw(json_escape(session[:usr_interval_file_path].to_json)) %>, 'remove_interval_file');

    function buildPairRow(index, pairId, savedPair = null) {
      const wrapper = document.createElement('div');
      wrapper.className = 'pair-row';
      wrapper.dataset.pairId = String(pairId);

      const label = document.createElement('strong');
      label.textContent = `Pair ${index}`;
      label.className = 'pair-row-label';

      const header = document.createElement('div');
      header.className = 'pair-row-header';
      const removePairButton = document.createElement('button');
      removePairButton.type = 'button';
      removePairButton.className = 'remove-pair-button';
      removePairButton.textContent = 'Remove pair';
      removePairButton.setAttribute('aria-label', `Remove pair ${index}`);
      removePairButton.addEventListener('click', () => {
        wrapper.remove();
        if (pairRows.children.length === 0) addPairRow();
        pairRows.querySelectorAll('.pair-row').forEach((row, idx) => {
          row.querySelector('.pair-row-label').textContent = `Pair ${idx + 1}`;
          row.querySelector('.remove-pair-button').setAttribute('aria-label', `Remove pair ${idx + 1}`);
        });
        addPairButton.focus();
      });
      header.appendChild(label);
      header.appendChild(removePairButton);

      const dataInput = document.createElement('input');
      dataInput.type = 'file';
      dataInput.name = `data_pair_files[${pairId}]`;
      dataInput.accept = '.asc,.tsv,.txt,.csv';

      const mappingInput = document.createElement('input');
      mappingInput.type = 'file';
      mappingInput.name = `mapping_pair_files[${pairId}]`;
      mappingInput.accept = '.asc,.tsv,.txt,.csv';

      if (savedPair) {
        const retained = document.createElement('input');
        retained.type = 'hidden';
        retained.name = `retained_pairs[${pairId}]`;
        retained.value = savedPair.id;
        wrapper.appendChild(retained);
      }
      wrapper.appendChild(header);
      wrapper.appendChild(dataInput);
      wrapper.appendChild(mappingInput);
      addFileRemoval(dataInput, 'Data file', savedPair?.data_name, 'remove_data_pairs[]');
      dataInput.parentNode.querySelector('input[type=hidden]').value = pairId;
      addFileRemoval(mappingInput, 'Mapping file', savedPair?.mapping_name, 'remove_mapping_pairs[]');
      mappingInput.parentNode.querySelector('input[type=hidden]').value = pairId;
      return wrapper;
    }

    function addPairRow(savedPair = null) {
      const index = pairRows.querySelectorAll('.pair-row').length + 1;
      const pairId = nextPairId;
      nextPairId += 1;
      pairRows.appendChild(buildPairRow(index, pairId, savedPair));
    }

    addPairButton.addEventListener('click', () => addPairRow());
    if (savedPairs.length) savedPairs.forEach(pair => addPairRow(pair));
    else addPairRow();

    if (gpTimeStepInput) {
      gpTimeStepInput.addEventListener('input', () => {
        gpTimeStepInput.value = gpTimeStepInput.value.replace(/\D/g, '').replace(/^0+/, '');
      });

      gpTimeStepInput.addEventListener('blur', () => {
        if (gpTimeStepInput.value === '') {
          gpTimeStepInput.value = '<%= Job::DEFAULT_TSS %>';
        }
      });
    }

    form.addEventListener('submit', (event) => {
      const rows = pairRows.querySelectorAll('.pair-row');
      for (const row of rows) {
        const dataInput = row.querySelector('input[type="file"][name^="data_pair_files["]');
        const mappingInput = row.querySelector('input[type="file"][name^="mapping_pair_files["]');
        const hasData = dataInput && (dataInput.files.length > 0 || !!dataInput.dataset.savedName);
        const hasMapping = mappingInput && (mappingInput.files.length > 0 || !!mappingInput.dataset.savedName);

        if (hasData !== hasMapping) {
          event.preventDefault();
          alert('Each pair must include both a data file and a mapping file.');
          return;
        }
      }

      const hasDataUpload = Array.from(rows).some(row => {
        const dataInput = row.querySelector('input[type="file"][name^="data_pair_files["]');
        return dataInput && (dataInput.files.length > 0 || !!dataInput.dataset.savedName);
      });

      if (!hasDataUpload) {
        event.preventDefault();
        alert('Please upload at least one data file.');
      }
    });
  });
</script>

<div class="background-space"></div>

</div>
  <%= render "layouts/footer" %>
</div>
