<div class = "upload">
  <!DOCTYPE html>
<html>
  <head>
    <title>Upload page</title>
    <%= stylesheet_link_tag 'upload' %>
  <head>
  <body>
    <%= yield %>
    <script>
    document.addEventListener("DOMContentLoaded", function() {
      var container = document.getElementById("data-files-container");
      var header = document.getElementById("data-files-header");
      var button = document.getElementById("view-files-button");
      var tableContainer = document.getElementById("data-files-table-container");
  
      button.style.display = "none"; // Hide the button initially
  
      button.addEventListener("click", function() {
        if (container.style.display === "none") {
          container.style.display = "block";
          header.style.display = "block";
        } else {
          container.style.display = "none";
          header.style.display = "none";
        }
      });
  
      // Show the button after the notice is displayed
      var notice = document.querySelector(".notice");
      if (notice) {
        button.style.display = "block";
      }

    });
  </script>
  </body>
</html>

<div class = "uploadscreen">
  <%= render "layouts/header" %>

  <div class="column skinny">
  <div class="stepper-wrapper">
  <div class="stepper-item active">
    <a href="<%= upload_path %>" style="text-decoration: none; color: #000750"> 
      <div class="step-counter">1</div>
      <div class="step-name">Upload Files</div>
    </a>
  </div>
  <div class="stepper-item">
      <div class="step-counter">2</div>
    </a>
    <div class="step-name">Select Analyses</div>
  </div>
  <div class="stepper-item">
    <div class="step-counter">3</div>
    <div class="step-name">Review</div>
  </div>
  <div class="stepper-item">
    <div class="step-counter">4</div>
    <div class="step-name">Submit</div>
  </div>
</div>

<h1>MicroNet: Upload Files</h1>
<p>
  The model takes plate reader data as input and a metadata/mapping file for each well.
  Valid formats: <code>.asc</code>, <code>.tsv</code>, <code>.txt</code>, <code>.csv</code>.  
  <a href="https://firasmidani.github.io/amiga/doc/metadata.html" target="_blank">Click here</a> to learn more.
</p>

<p style="font-weight: 500; color: white; margin-top: 10px;">
  <em>Note:</em> Before clicking <strong>"Upload"</strong>, please drag and arrange your files to ensure that each data file matches its corresponding mapping file.
</p>

<form id="upload-form" method="post" enctype="multipart/form-data" action="<%= upload_path %>">
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
  <input type="hidden" name="ordered_data_files" id="ordered_data_files">
  <input type="hidden" name="ordered_mapping_files" id="ordered_mapping_files">

  <div style="display: flex; gap: 40px; margin-top: 30px;">
    <!-- Data Files Column -->
    <div>
      <h2>Data Files</h2>
      <ul id="data-files-list" class="sortable-list"></ul>
      <input type="file" id="data-file-input" multiple name="data_files[]">
    </div>

    <!-- Mapping Files Column -->
    <div>
      <h2>Mapping Files</h2>
      <ul id="mapping-files-list" class="sortable-list"></ul>
      <input type="file" id="mapping-file-input" multiple name="mapping_files[]">
    </div>
  </div>

  <input type="submit" value="Upload" class="upload-button" style="margin-top: 20px;">
</form>

<% if flash.now[:alert] %>
  <div class="error"><%= flash.now[:alert] %></div>
<% end %>

<% if flash.now[:error] %>
  <div class="error"><%= flash.now[:error] %></div>
<% end %>


  <% if @data_file_paths.present? && @mapping_file_paths.present? %>
  <div class="notice">
    <p>
      <span class="success" style="color: green; font-weight: 500;">Files uploaded successfully! </span>
    </p>
    <div class="upload-notice" style="color: white; font-weight: 300;">
      <p>
        <span class="current">Currently uploaded data file(s): <%= @usr_data_file_names %></span>
      </p>
      <p>
        <span class="current">Currently uploaded mapping file(s): <%= @usr_mapping_file_names %></span>
      </p>
    </div>
  </div>
<% end %>


<style>
  .sortable-list {
    list-style: none;
    padding: 10px;
    min-height: 50px;
    width: 300px;
    border: 1px solid #ccc;
    background: #f9f9f9;
    border-radius: 6px;
    margin-bottom: 10px;
    overflow-x: hidden;
  }

  .sortable-item {
    padding: 8px 12px;
    margin: 4px 0;
    background: white;
    border: 1px solid #ddd;
    border-radius: 4px;
    color: #222;
    font-size: 14px;
    word-wrap: break-word;
    cursor: grab;
  }

  .sortable-item:hover {
    background: #eef;
  }
</style>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    new Sortable(document.getElementById('data-files-list'), { animation: 150 });
    new Sortable(document.getElementById('mapping-files-list'), { animation: 150 });

    function handleFileInput(inputId, listId) {
      const input = document.getElementById(inputId);
      const list = document.getElementById(listId);

      input.addEventListener('change', () => {
        list.innerHTML = '';
        Array.from(input.files).forEach(file => {
          const li = document.createElement('li');
          li.className = 'sortable-item';
          li.innerText = file.name;
          list.appendChild(li);
        });
      });
    }

    handleFileInput('data-file-input', 'data-files-list');
    handleFileInput('mapping-file-input', 'mapping-files-list');

    // On form submission, capture file order
    const form = document.getElementById('upload-form');
    form.addEventListener('submit', (e) => {
      const dataList = Array.from(document.querySelectorAll('#data-files-list .sortable-item')).map(el => el.innerText);
      const mappingList = Array.from(document.querySelectorAll('#mapping-files-list .sortable-item')).map(el => el.innerText);

      document.getElementById('ordered_data_files').value = JSON.stringify(dataList);
      document.getElementById('ordered_mapping_files').value = JSON.stringify(mappingList);
    });
  });
</script>

  <% if @data_file_paths.present? && @mapping_file_paths.present? && File.exist?(@mapping_file_paths[0]) %>
  <%= link_to "Next", 'selectanalyses', class: "next-button" %>
  <% end %>
<div class="background-space"></div>

</div>
  <%= render "layouts/footer" %>
</div>
