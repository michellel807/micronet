
<div class="welcomescreen">
    <%= render "layouts/header" %>

    <main class="welcome-main">
      <section class="welcome-hero">
        <span class="welcome-eyebrow">Schmid Lab · Duke University</span>
        <h1>Model microbial growth with confidence</h1>
        <p class="welcome-sub">
          MicroNet helps researchers visualize and model trends in microbial growth data.
          Using a non-parametric Gaussian Process regression approach, it estimates standard
          growth parameters — even when growth deviates from expected logistic or sigmoidal curves.
        </p>
        <p class="welcome-note">
          Results are typically reported within a few hours, with an automated email sent once
          your analysis is ready.
        </p>

        <div class="welcome-cta">
          <%= form_with url: "/", method: :post, class: "welcome-form" do |form| %>
            <label class="welcome-form-label" for="email">Where should we send your results?</label>
            <div class="welcome-form-row">
              <%= form.text_field :email,
                    value: (params[:email] || session[:email]),
                    placeholder: "you@institution.edu",
                    class: "welcome-email-input" %>
              <%= form.submit "Begin analysis", class: "ds-btn ds-btn-accent ds-btn-lg" %>
            </div>
          <% end %>
          <div class="welcome-helprow">
            <%= link_to 'Need help getting started?', "help", id: "help_link" %>
          </div>
          <p class="welcome-note">Each new analysis starts fresh. Temporary uploads expire after 24 hours of inactivity.</p>
          <div class="email-alert"><%= flash[:notice] %></div>
        </div>

        <% if flash[:alert].present? && flash[:alert] != "Need help?" %>
          <div class="welcome-alert">
            <p><%= flash[:alert] %></p>
          </div>
        <% end %>
      </section>
    </main>

    <%= render "layouts/footer" %>
</div>
