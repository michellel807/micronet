<% content_for :title, "RNA-seq: Choose Comparison" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "parameter", "rnaseq", "data-turbo-track": "reload" %>
<% end %>
<% levels_by_column = @inputs.levels_by_column %>
<% level_options = ->(column) { levels_by_column.fetch(column, {}).map { |level, count| ["#{level} (#{count} samples)", level] } } %>
<% defaults = RnaSeq::Configuration::ADVANCED_DEFAULTS %>
<% types = {
     "two_condition" => ["Compare two conditions", "Which genes differ between a test condition and a reference? For example, treated vs control."],
     "time_course" => ["Change over time", "Which genes change at any time point? Uses one condition, or all samples."],
     "condition_by_time" => ["Compare conditions over time", "Which genes change differently over time in a test condition than in a reference?"],
     "condition_time_gp" => ["Compare conditions over time (Gaussian process test)", "Which groups of genes follow a different course over time in a test condition than in a reference? Tests each gene cluster's curves, without a gene-by-gene DESeq2 test."]
   } %>
<% gp = "condition_time_gp" %>

<div class="parameterscreen rnaseq">
  <%= render "layouts/header" %>

  <div class="column skinny">
    <%= render "layouts/stepper", current_step: 2, steps: rnaseq_steps %>

    <h1>RNA-seq: Choose Comparison</h1>
    <p>Choose what to test. <%= @inputs.sample_ids.length %> samples in <strong><%= @files.dig("original", "counts") %></strong>.</p>

    <% if flash[:alert].present? %>
      <div class="rnaseq-alert" role="alert"><%= flash[:alert] %></div>
    <% end %>

    <%= form_with url: rnaseq_configure_path, method: :post, class: "rnaseq-form", id: "rnaseq-configure",
                  data: { levels: levels_by_column.to_json, varies_within: @inputs.columns_varying_within.to_json } do %>
      <div class="general-white-block">
        <h2>Type of analysis</h2>
        <fieldset class="rnaseq-types">
          <legend class="visually-hidden">Type of analysis</legend>
          <% types.each do |value, (title, description)| %>
            <label class="rnaseq-type">
              <%= radio_button_tag :experiment_type, value, @form["experiment_type"] == value %>
              <span class="rnaseq-type-title"><%= title %></span>
              <span class="rnaseq-type-description"><%= description %></span>
            </label>
          <% end %>
        </fieldset>

        <h2>Samples</h2>
        <div class="ds-field" data-show-for="time_course condition_by_time <%= gp %>">
          <label class="ds-label" for="time_column">Time column</label>
          <%= select_tag :time_column, options_for_select(@inputs.condition_columns, @form["time_column"]), class: "ds-select" %>
          <p class="rnaseq-hint">The sample sheet column with each sample's time point, such as 0, 6 and 24. Each time point is treated as its own group, so every time point needs at least <%= RnaSeq::Inputs::MIN_REPLICATES %> replicates<span data-show-for="condition_by_time"> in each condition</span>.<span data-show-for="<%= gp %>"> The times must be numbers, and at least 3 are needed.</span></p>
          <p class="rnaseq-hint" data-show-for="<%= gp %>" data-time-points></p>
        </div>

        <div class="ds-field">
          <label class="ds-label" for="condition_column">Condition column</label>
          <%= select_tag :condition_column, options_for_select(@inputs.condition_columns, @form["condition_column"]), class: "ds-select" %>
          <p class="rnaseq-hint" data-show-for="two_condition condition_by_time <%= gp %>">The sample sheet column that says which condition each sample belongs to.</p>
          <p class="rnaseq-hint" data-show-for="time_course">Used only if you choose to analyze one condition below.</p>
        </div>

        <div class="ds-field" data-show-for="time_course">
          <label class="ds-label" for="subset_level">Samples to analyze</label>
          <%= select_tag :subset_level, options_for_select(level_options.call(@form["condition_column"]), @form["subset_level"]),
                include_blank: "All samples", class: "ds-select", data: { level_select: true } %>
          <p class="rnaseq-hint">Analyze one condition's samples, or all samples together. With all samples, samples from different conditions count as replicates of each other unless the condition is added as a covariate.</p>
          <p class="ds-alert ds-alert--info" role="status" data-pooling-note hidden></p>
        </div>

        <div class="rnaseq-pair" data-show-for="two_condition condition_by_time <%= gp %>">
          <div class="ds-field">
            <label class="ds-label" for="reference_level">Reference condition</label>
            <%= select_tag :reference_level, options_for_select(level_options.call(@form["condition_column"]), @form["reference_level"]),
                  include_blank: "Choose…", class: "ds-select", data: { level_select: true } %>
            <p class="rnaseq-hint">The baseline, such as control or wild type.</p>
          </div>
          <div class="ds-field">
            <label class="ds-label" for="test_level">Test condition</label>
            <%= select_tag :test_level, options_for_select(level_options.call(@form["condition_column"]), @form["test_level"]),
                  include_blank: "Choose…", class: "ds-select", data: { level_select: true } %>
            <p class="rnaseq-hint">The condition compared against the reference.</p>
          </div>
        </div>
        <p class="rnaseq-hint" data-show-for="two_condition">Each condition needs at least <%= RnaSeq::Inputs::MIN_REPLICATES %> replicate samples; 3 or more are recommended.</p>
        <p class="rnaseq-hint" data-show-for="condition_by_time">Only the two chosen conditions are analyzed, and both need samples at every time point.</p>

        <fieldset class="ds-field rnaseq-radios" data-show-for="<%= gp %>">
          <legend class="ds-label">When was the treatment given?</legend>
          <label><%= radio_button_tag :treatment_timing, "start", @form["treatment_timing"] != "added" %> Before the first sample (treated from the start)</label>
          <label><%= radio_button_tag :treatment_timing, "added", @form["treatment_timing"] == "added" %> Partway through, at time</label>
          <div data-treatment-start>
            <label class="visually-hidden" for="treatment_start">Time the treatment was added</label>
            <%= text_field_tag :treatment_start, @form["treatment_start"], class: "ds-input", inputmode: "decimal", placeholder: "for example 6" %>
          </div>
          <p class="rnaseq-hint">From the start, the conditions may differ at every time point. Partway through, samples taken up to that time count as one shared group, the difference starts at zero there, and only later samples are compared. A sample taken exactly at that time counts as before the treatment.</p>
        </fieldset>

        <fieldset class="ds-field rnaseq-radios" data-show-for="<%= gp %>">
          <legend class="ds-label">How were the samples collected?</legend>
          <% RnaSeq::Configuration::SAMPLING_DESIGNS.each do |value, label| %>
            <label><%= radio_button_tag :sampling_design, value, @form["sampling_design"] == value %> <%= label %></label>
          <% end %>
          <div class="ds-field" data-replicate-column>
            <label class="ds-label" for="replicate_column">Column naming each culture</label>
            <%= select_tag :replicate_column, options_for_select(@inputs.condition_columns, @form["replicate_column"]),
                  include_blank: "Choose…", class: "ds-select" %>
          </div>
          <p class="rnaseq-hint">This decides how significance is tested, and it cannot be told from the data, so please choose. If each culture was sampled at several time points, its samples are related: the test then moves whole cultures between the conditions when it shuffles labels. With few cultures this limits how small a p-value can be (with 3 per condition, never below 0.05).</p>
        </fieldset>

        <fieldset class="ds-field rnaseq-radios" data-show-for="time_course condition_by_time <%= gp %>">
          <legend class="ds-label">Gene clustering</legend>
          <div data-show-for="time_course condition_by_time">
            <%= hidden_field_tag :cluster_genes, "0", id: nil %>
            <label class="rnaseq-checkbox" for="cluster_genes"><%= check_box_tag :cluster_genes, "1", @form["cluster_genes"] == "1" %> Group the significant genes into clusters by their pattern over time</label>
            <p class="rnaseq-hint">Clustering also draws a Gaussian process curve for each cluster. Turn it off to get only the differential expression results and plots.</p>
          </div>
          <div class="ds-field" data-show-for="<%= gp %>">
            <label class="ds-label" for="variable_percent">Keep the top __% most variable genes</label>
            <%= text_field_tag :variable_percent, @form["variable_percent"], class: "ds-input", inputmode: "decimal", placeholder: "Automatic" %>
            <p class="rnaseq-hint">Genes are chosen by how much they vary across all samples, without looking at the conditions, and then clustered by their values in every sample. Leave blank to keep the <%= RnaSeq::Configuration::AUTOMATIC_GENES %> most variable genes, or half of the genes if that is fewer.</p>
          </div>
          <div data-cluster-options>
            <label class="ds-label" for="clusters">Number of gene clusters</label>
            <%= select_tag :clusters, options_for_select([["Automatic (recommended)", ""]] + RnaSeq::Configuration::CLUSTER_COUNTS.map { |count| [count, count.to_s] }, @form["clusters"]), class: "ds-select" %>
            <p class="rnaseq-hint">Automatic tries 2 to 10 groups and keeps the number that separates the patterns best (highest silhouette score).</p>
            <label class="rnaseq-checkbox" for="silhouette_baseline"><%= check_box_tag :silhouette_baseline, "1", @form["silhouette_baseline"] == "1" %> Check silhouette reliability against a random baseline</label>
            <p class="rnaseq-hint">Also clusters 5 shuffled copies of your data, which keep each gene's shape but scramble its timing, and reports their average silhouette, your actual silhouette, and the difference. A difference near 0 means the clusters are no better separated than random patterns. Adds a little run time.</p>
          </div>
        </fieldset>

        <details class="rnaseq-advanced" <%= "open" if @advanced_open %>>
          <summary>Advanced settings</summary>
          <p class="rnaseq-hint">The defaults suit most experiments.</p>

          <div class="rnaseq-pair">
            <div class="ds-field">
              <label class="ds-label" for="alpha">Significance level (adjusted p-value)</label>
              <%= text_field_tag :alpha, @form["alpha"], class: "ds-input", inputmode: "decimal" %>
              <p class="rnaseq-hint"><span data-show-for="two_condition time_course condition_by_time">Genes</span><span data-show-for="<%= gp %>">Gene clusters</span> with an adjusted p-value below this are called significant. Default <%= defaults["alpha"] %>.</p>
            </div>
            <div class="ds-field" data-show-for="two_condition time_course condition_by_time">
              <label class="ds-label" for="lfc_threshold">Log2 fold-change cutoff</label>
              <%= text_field_tag :lfc_threshold, @form["lfc_threshold"], class: "ds-input", inputmode: "decimal" %>
              <p class="rnaseq-hint">0 means no cutoff. 1 means at least a two-fold change<span data-show-for="time_course condition_by_time"> at one or more time points</span>.</p>
            </div>
          </div>

          <fieldset class="ds-field rnaseq-radios" data-show-for="two_condition">
            <legend class="ds-label">How to apply the fold-change cutoff</legend>
            <% RnaSeq::Configuration::LFC_TESTS.each do |value, label| %>
              <label><%= radio_button_tag :lfc_test, value, @form["lfc_test"] == value %> <%= label %></label>
            <% end %>
            <p class="rnaseq-hint">Filtering after testing keeps genes whose estimated change passes the cutoff. Testing against the cutoff is stricter: it asks whether the true change is larger than the cutoff. Has no effect when the cutoff is 0.</p>
          </fieldset>

          <fieldset class="ds-field rnaseq-radios" data-show-for="two_condition">
            <legend class="ds-label">Samples in the model</legend>
            <% RnaSeq::Configuration::SAMPLES_IN_MODEL.each do |value, label| %>
              <label><%= radio_button_tag :samples_in_model, value, @form["samples_in_model"] == value %> <%= label %></label>
            <% end %>
            <p class="rnaseq-hint">If the sample sheet has more than two conditions, keeping all samples gives DESeq2 more data to estimate variability.</p>
          </fieldset>

          <div class="ds-field" data-show-for="<%= gp %>">
            <label class="ds-label" for="permutations">Permutations</label>
            <%= text_field_tag :permutations, @form["permutations"], class: "ds-input", inputmode: "numeric",
                  placeholder: RnaSeq::Configuration::DEFAULT_PERMUTATIONS.to_s %>
            <p class="rnaseq-hint">How many label shuffles to compare each cluster against (<%= RnaSeq::Configuration::PERMUTATION_COUNTS.min %> to <%= RnaSeq::Configuration::PERMUTATION_COUNTS.max %>; default <%= RnaSeq::Configuration::DEFAULT_PERMUTATIONS %>). When there are fewer possible shuffles, all of them are used. More takes longer.</p>
          </div>

          <fieldset class="ds-field rnaseq-radios">
            <legend class="ds-label">Covariates</legend>
            <% covariate_options = @inputs.condition_columns %>
            <% if covariate_options.length < 2 %>
              <p class="rnaseq-hint">Add columns such as <code>batch</code> to the sample sheet to adjust for them.</p>
            <% else %>
              <% covariate_options.each do |column| %>
                <label data-covariate="<%= column %>"><%= check_box_tag "covariates[]", column, @form["covariates"].include?(column), id: "covariate_#{column.parameterize(separator: '_')}" %> <%= column %></label>
              <% end %>
              <p class="rnaseq-hint">Other sample sheet columns, such as batch, to adjust for. The condition and time columns cannot also be covariates.</p>
            <% end %>
          </fieldset>

        </details>
      </div>

      <div class="rnaseq-actions">
        <%= link_to "Back", rnaseq_upload_path, class: "ds-btn ds-btn-secondary ds-btn-back" %>
        <%= submit_tag "Continue", class: "ds-btn ds-btn-accent ds-btn-next" %>
      </div>
    <% end %>
  </div>

  <%= render "layouts/footer" %>
</div>

<script>
  (function () {
    var form = document.getElementById("rnaseq-configure");
    if (!form) return;
    var levels = JSON.parse(form.dataset.levels || "{}");
    var variesWithin = JSON.parse(form.dataset.variesWithin || "{}");
    var poolingNote = form.querySelector("[data-pooling-note]");
    var advanced = form.querySelector("details.rnaseq-advanced");
    var pooling = null; // the condition column auto-added as a covariate, if any
    var column = document.getElementById("condition_column");
    var timeColumn = document.getElementById("time_column");
    var selects = form.querySelectorAll("[data-level-select]");

    function type() {
      var checked = form.querySelector("input[name=experiment_type]:checked");
      return checked ? checked.value : "two_condition";
    }

    function fillLevels() {
      var options = levels[column.value] || {};
      selects.forEach(function (select) {
        var previous = select.value;
        select.length = 1; // keep the blank first option
        Object.keys(options).forEach(function (level) {
          var option = new Option(level + " (" + options[level] + " samples)", level);
          option.selected = level === previous;
          select.add(option);
        });
      });
    }

    function update() {
      var current = type();
      var subset = document.getElementById("subset_level");
      form.querySelectorAll("[data-show-for]").forEach(function (element) {
        var shown = element.dataset.showFor.split(" ").indexOf(current) !== -1;
        element.hidden = !shown;
        element.querySelectorAll("select, input").forEach(function (input) { input.disabled = !shown; });
      });
      // The cluster count and reliability check only apply when clustering is on.
      var clusterBox = document.getElementById("cluster_genes");
      var clusterOptions = form.querySelector("[data-cluster-options]");
      if (clusterBox && clusterOptions) {
        var clustering = clusterBox.checked && !clusterBox.disabled;
        clusterOptions.hidden = !clustering;
        clusterOptions.querySelectorAll("select, input").forEach(function (input) { input.disabled = !clustering; });
      }
      // The Gaussian process comparison: the treatment time and the culture column
      // apply only to their own choices; clustering is always on.
      var gp = current === "condition_time_gp";
      if (gp && clusterOptions) {
        clusterOptions.hidden = false;
        clusterOptions.querySelectorAll("select, input").forEach(function (input) { input.disabled = false; });
      }
      var added = form.querySelector("input[name=treatment_timing][value=added]");
      toggle(form.querySelector("[data-treatment-start]"), gp && added && added.checked);
      var repeated = form.querySelector("input[name=sampling_design][value=repeated]");
      var repeatedSampling = gp && repeated && repeated.checked;
      toggle(form.querySelector("[data-replicate-column]"), repeatedSampling);
      var culture = document.getElementById("replicate_column");
      var timePoints = form.querySelector("[data-time-points]");
      if (timePoints) {
        var times = Object.keys(levels[timeColumn.value] || {});
        timePoints.textContent = times.length ? "Time points in your sample sheet: " + times.join(", ") + "." : "";
      }
      // In a time course the condition column only matters when one condition is chosen.
      var usesCondition = current !== "time_course" || (subset && subset.value !== "");
      var usesTime = current !== "two_condition";
      form.querySelectorAll("[data-covariate]").forEach(function (label) {
        var reserved = (usesCondition && label.dataset.covariate === column.value) ||
                       (usesTime && label.dataset.covariate === timeColumn.value) ||
                       (repeatedSampling && culture && label.dataset.covariate === culture.value);
        var box = label.querySelector("input");
        box.disabled = reserved;
        if (reserved) box.checked = false;
        label.classList.toggle("is-disabled", reserved);
      });
    }

    function toggle(element, shown) {
      if (!element) return;
      element.hidden = !shown;
      element.querySelectorAll("select, input").forEach(function (input) { input.disabled = !shown; });
    }

    function covariateBox(name) {
      var label = form.querySelector('[data-covariate="' + (window.CSS && CSS.escape ? CSS.escape(name) : name) + '"]');
      return label ? label.querySelector("input") : null;
    }

    // A time course of all samples whose condition column varies within time
    // points: add that column as a covariate so the conditions' differences are
    // not counted as noise. Runs only on user changes, never on page load, so a
    // saved or re-shown form keeps the user's own choice.
    function adjustPooling(event) {
      var subset = document.getElementById("subset_level");
      var wanted = type() === "time_course" && subset && subset.value === "" && column.value !== timeColumn.value &&
                   (variesWithin[timeColumn.value] || []).indexOf(column.value) !== -1 ? column.value : null;
      var previous = pooling && covariateBox(pooling);
      if (event && previous && event.target === previous) {
        // The user ticked or unticked the auto-added box: it is theirs now.
        delete previous.dataset.auto;
        if (!previous.checked) { pooling = null; poolingNote.hidden = true; }
        return;
      }
      if (wanted === pooling) return;
      if (previous && previous.dataset.auto) { previous.checked = false; delete previous.dataset.auto; }
      pooling = null;
      poolingNote.hidden = true;
      var box = wanted && covariateBox(wanted);
      if (box && !box.disabled && !box.checked) {
        box.checked = true;
        box.dataset.auto = "1";
        pooling = wanted;
        poolingNote.textContent = "Your samples include more than one " + wanted + " at the same time points. " + wanted +
          " has been added as a covariate under Advanced settings so that their differences are not counted as noise. Untick it there to pool them.";
        poolingNote.hidden = false;
        if (advanced) advanced.open = true;
      }
    }

    column.addEventListener("change", function () { fillLevels(); update(); });
    form.addEventListener("change", function (event) { update(); adjustPooling(event); });
    fillLevels();
    update();
  })();
</script>
